      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Numbers With No -s",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "In a compound adjective with a number, the noun stays singular: a three-day camp, not a three-days camp.",
          "scope": "Number + noun compound adjectives",
          "examples": [
            {
              "sentence": "Our school organised a three-day camp.",
              "highlight": [
                "three-day"
              ],
              "explanation": "Day stays singular inside the compound adjective."
            },
            {
              "sentence": "It is a five-minute walk to the park.",
              "highlight": [
                "five-minute"
              ],
              "explanation": "Minute stays singular inside the compound adjective."
            }
          ]
        }
      ],
      "key_takeaway": "A ten-year-old girl, never ten-years-old.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Hyphens or Separate Words?",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "comparison",
          "items": [
            {
              "label": "Before a noun",
              "description": "Joined with hyphens; the noun inside is singular.",
              "example": "Meena has a twelve-year-old brother."
            },
            {
              "label": "After the verb",
              "description": "Separate words, no hyphens, plural noun.",
              "example": "Meena's brother is twelve years old."
            }
          ],
          "comparison_points": [
            "In the first sentence, the words work as one adjective before brother.",
            "In the second, they come after is, so they are written separately."
          ],
          "conclusion": "Use hyphens only when the words sit together before a noun."
        }
      ],
      "key_takeaway": "Hyphens before the noun, not after the verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
