          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Two or more words join to make one adjective.",
            "Before a noun, join them with hyphens.",
            "Number compounds keep the noun singular: a two-hour film.",
            "After the verb, no hyphens: The film is two hours long."
          ]
        }
      ],
      "key_takeaway": "Join the words, hyphen them, keep the number noun singular.",
