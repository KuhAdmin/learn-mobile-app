      "title": "Describing How People Look",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "A describing word + a body part + -ed tells how someone looks."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "A curly-haired girl won the spelling quiz.",
              "highlight": [
                "curly-haired"
              ],
              "explanation": "Curly + hair + -ed describes the girl's hair."
            }
          ]
        }
      ],
      "key_takeaway": "Curly-haired, blue-eyed, long-legged.",
