  "lesson": {
    "lesson_title": "Compound Adjectives",
    "lesson_summary": "Learners meet adjectives made of two or more words, usually joined with hyphens before a noun: well-known, part-time, blue-eyed, curly-haired. They learn that in number compounds the noun stays singular (a three-day camp, a ten-year-old girl), and that after a verb the words are written separately with no hyphens ('She is ten years old'). Compound nouns were taught in 1-2-7; hyphen rules in general come in Stage 5.5.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise and form compound adjectives.",
        "success_criteria": [
          "Spot hyphenated adjectives.",
          "Use adjective + body part + -ed to describe people."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Write number compounds and place hyphens correctly.",
        "success_criteria": [
          "Write a ten-year-old girl with no -s.",
          "Leave out hyphens after the verb."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
