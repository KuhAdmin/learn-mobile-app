      "title": "Two Words, One Adjective",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Two or more words can join to make one adjective. Before a noun, they are usually joined with hyphens."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Ruskin Bond is a well-known writer.",
              "highlight": [
                "well-known"
              ],
              "explanation": "Well and known join to describe the writer as famous."
            }
          ]
        }
      ],
      "key_takeaway": "Compound adjectives join words with hyphens.",
