  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "When A Becomes An",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Before a vowel sound, a changes to an. Try saying 'a orange': the two vowel sounds bump together. An keeps them apart."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "She peeled an orange for her little brother.",
              "highlight": [
                "an orange"
              ],
              "explanation": "Orange starts with a vowel sound, so we use an."
            }
          ]
        }
      ],
      "key_takeaway": "An makes vowel sounds easy to say.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Vowel Sound or Consonant Sound?",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use an before a word that starts with a vowel sound. Use a before a word that starts with a consonant sound.",
          "scope": "The indefinite articles a and an",
          "examples": [
            {
              "sentence": "Rahul found an earring under the sofa.",
              "highlight": [
                "an earring"
              ],
              "explanation": "Earring starts with a vowel sound, so an."
            },
            {
              "sentence": "We watched a lizard on the kitchen wall.",
              "highlight": [
                "a lizard"
              ],
              "explanation": "Lizard starts with a consonant sound, so a."
            }
          ]
        }
      ],
      "key_takeaway": "Vowel sound: an. Consonant sound: a.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "The Silent H",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "In a few words the h is silent, so the word really starts with a vowel sound."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "We waited an hour for the ferry.",
              "highlight": [
                "an hour"
              ],
              "explanation": "Hour sounds like 'our', so we use an."
            },
            {
              "sentence": "Mr Das is an honest shopkeeper.",
              "highlight": [
                "an honest shopkeeper"
              ],
              "explanation": "Honest sounds like 'onest', so we use an."
            }
          ]
        }
      ],
      "key_takeaway": "Silent h means a vowel sound: an hour.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Vowel Letters With Consonant Sounds",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Some words start with a vowel letter but a consonant sound. U often sounds like 'you', and one sounds like 'won'."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Our school has a uniform with a red tie.",
              "highlight": [
                "a uniform"
              ],
              "explanation": "Uniform starts with a 'you' sound, a consonant sound, so a."
            },
            {
              "sentence": "Turn left into a one-way street.",
              "highlight": [
                "a one-way street"
              ],
              "explanation": "One starts with a 'w' sound, so a."
            }
          ]
        }
      ],
      "key_takeaway": "Listen to the sound: a uniform, a one-way street.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Letters Said One by One",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "When we say letters one by one, listen to how the first letter is said: X is 'ex', M is 'em', U is 'you'."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "The doctor asked for an X-ray of my wrist.",
              "highlight": [
                "an X-ray"
              ],
              "explanation": "X is said 'ex', which starts with a vowel sound, so an."
            }
          ]
        }
      ],
      "key_takeaway": "Say the letter aloud to choose a or an.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "The Very Next Word Decides",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "Choose a or an by the word right after it. If a describing word comes before the noun, the describing word decides.",
          "scope": "A or an before describing words",
          "examples": [
            {
              "sentence": "Grandpa rides an old bicycle to the market.",
              "highlight": [
                "an old bicycle"
              ],
              "explanation": "Old comes right after the article and starts with a vowel sound, so an."
            },
            {
              "sentence": "I bit into a huge apple.",
              "highlight": [
                "a huge apple"
              ],
              "explanation": "Huge comes right after the article, so a, even though apple starts with a vowel."
            }
          ]
        }
      ],
      "key_takeaway": "Look at the very next word, not the noun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "A or An: Recap",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Vowel sound: an. Consonant sound: a.",
            "Silent h: an hour, an honest man.",
            "'You' and 'w' sounds: a uniform, a one-way street.",
            "Say letters aloud: an X-ray.",
            "The very next word decides: an old car, a huge apple."
          ]
        }
      ],
      "key_takeaway": "Trust your ears, not the spelling.",
