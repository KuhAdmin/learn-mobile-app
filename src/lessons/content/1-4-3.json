  "lesson": {
    "lesson_title": "Indefinite Article – An",
    "lesson_summary": "Learners already know what a means (1-4-2). This lesson teaches when it becomes an: before a vowel sound. They learn to listen rather than look (an hour, a uniform, a one-way street, an X-ray), and see that the word right after the article decides, even if it is a describing word (an old car, a huge apple).",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use an before a vowel sound and a before a consonant sound.",
        "success_criteria": [
          "Choose an egg and a lizard."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Choose by sound, not by spelling.",
        "success_criteria": [
          "Use an hour and an honest man.",
          "Use a uniform and a one-way street.",
          "Use an X-ray."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Let the next word decide.",
        "success_criteria": [
          "Choose an old car but a huge apple."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
