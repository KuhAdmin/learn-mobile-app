  "lesson": {
    "lesson_title": "Adverbs of Manner",
    "lesson_summary": "Adverbs of manner answer \"how?\". Learners meet common manner adverbs, including well and badly, learn to put them after the verb or after the object, and see how a well-chosen manner adverb (or a stronger verb) makes writing precise. Spelling rules for -ly come in 2-2-16; good or well comes in 2-2-15.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise adverbs of manner.",
        "success_criteria": [
          "Find the word that tells how.",
          "Use well and badly."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Place manner adverbs correctly.",
        "success_criteria": [
          "Put the adverb after the verb.",
          "Put it after the object, not before it."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Choose manner adverbs that fit the meaning.",
        "success_criteria": [
          "Pick the adverb that shows a feeling.",
          "Compare an adverb with a stronger verb."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
