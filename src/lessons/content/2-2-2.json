  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "How Did It Happen?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Adverbs of manner tell us how someone does something."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The nurse lifted the newborn gently.",
              "highlight": [
                "gently"
              ],
              "explanation": "Gently tells how the nurse lifted the newborn."
            }
          ]
        }
      ],
      "key_takeaway": "Manner adverbs tell how.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Common Manner Adverbs",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Each of these answers \"how?\":",
          "list_style": "bulleted",
          "items": [
            "calmly",
            "politely",
            "bravely",
            "neatly",
            "loudly",
            "silently",
            "well",
            "badly"
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Tip",
          "text": "Most manner adverbs end in -ly, but well and badly are two you will use every day."
        }
      ],
      "key_takeaway": "Many manner adverbs end in -ly.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Well and Badly",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "Well says something was done in a good way. Badly says it was done in a poor way."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Rahul plays the flute well.",
              "highlight": [
                "well"
              ],
              "explanation": "Well tells how Rahul plays."
            },
            {
              "sentence": "I slept badly on the train.",
              "highlight": [
                "badly"
              ],
              "explanation": "Badly tells how I slept."
            }
          ]
        }
      ],
      "key_takeaway": "Well and badly tell how well something went.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Right After the Verb",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "When there is no object, a manner adverb usually comes right after the verb.",
          "scope": "Verbs with no object",
          "examples": [
            {
              "sentence": "The tortoise crawled slowly across the path.",
              "highlight": [
                "slowly"
              ],
              "explanation": "Slowly comes straight after crawled."
            }
          ]
        }
      ],
      "key_takeaway": "No object? Put it after the verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "After the Object",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "When the verb has an object, put the manner adverb after the object.",
          "scope": "Verbs with an object",
          "examples": [
            {
              "sentence": "She folded the letter neatly.",
              "highlight": [
                "neatly"
              ],
              "explanation": "The object the letter stays next to folded, and neatly comes after it."
            }
          ]
        },
        {
          "block_id": "BLOCK009",
          "type": "note",
          "title": "Not this",
          "text": "She folded neatly the letter. The adverb must not split the verb from its object."
        }
      ],
      "key_takeaway": "Keep the verb and its object together.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 61,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Plain or Precise?",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "comparison",
          "items": [
            {
              "label": "With a manner adverb",
              "description": "An ordinary verb plus an adverb.",
              "example": "The boy walked slowly to the gate."
            },
            {
              "label": "With a stronger verb",
              "description": "One verb that already shows the manner.",
              "example": "The boy trudged to the gate."
            }
          ],
          "comparison_points": [
            "In the first sentence, slowly tells how he walked.",
            "In the second, trudged already means walked slowly and heavily."
          ],
          "conclusion": "Both are correct. Choose the one that paints the clearest picture."
        }
      ],
      "key_takeaway": "A stronger verb can hold the manner.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 68,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Adverbs Show Feelings",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "text",
          "text": "Change the manner adverb and the reader sees a different person."
        },
        {
          "block_id": "BLOCK012",
          "type": "example",
          "examples": [
            {
              "sentence": "Priya closed the door softly.",
              "highlight": [
                "softly"
              ],
              "explanation": "Softly suggests she didn't want to wake anyone."
            },
            {
              "sentence": "Priya closed the door angrily.",
              "highlight": [
                "angrily"
              ],
              "explanation": "Angrily shows that she was upset."
            }
          ]
        }
      ],
      "key_takeaway": "The adverb can show how someone feels.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 44,
        "density_status": "passed",
