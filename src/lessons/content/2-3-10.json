  "lesson": {
    "lesson_title": "Agreement with There Is and There Are",
    "lesson_summary": "After there, the real subject comes after the verb, so learners look ahead to choose there is or there are, there was or there were. They use is there? and are there? in questions, let the first item of a list decide the verb, use there are in writing where speech often says there's, and match how many with are and how much with is.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose there is or there are, there was or there were.",
        "success_criteria": [
          "Look at the noun after the verb."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use there in questions and before lists.",
        "success_criteria": [
          "Choose is there? or are there?",
          "Let the first item of a list decide."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use there are correctly in writing.",
        "success_criteria": [
          "Replace there's before a plural noun.",
          "Match how many and how much."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
