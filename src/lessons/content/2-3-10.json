  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "When the Subject Comes After",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "In sentences that start with there is or there are, the real subject comes after the verb. Look ahead to choose the verb."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "There is a lizard on the ceiling.",
              "highlight": [
                "There is a lizard"
              ],
              "explanation": "The subject is a lizard, which is singular."
            }
          ]
        }
      ],
      "key_takeaway": "Look after there for the subject.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 51,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "There Is or There Are",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "Use there is before a singular or uncountable noun, and there are before a plural noun.",
          "scope": "there is / there are",
          "examples": [
            {
              "sentence": "There is some rice in the pot.",
              "highlight": [
                "There is some rice"
              ],
              "explanation": "Rice is uncountable, so there is."
            },
            {
              "sentence": "There are three kittens under the porch.",
              "highlight": [
                "There are three kittens"
              ],
              "explanation": "Kittens is plural, so there are."
            }
          ]
        }
      ],
      "key_takeaway": "Singular or uncountable: is. Plural: are.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 62,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "There Was and There Were",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "In the past, use there was before a singular noun and there were before a plural noun.",
          "scope": "there was / there were",
          "examples": [
            {
              "sentence": "There was a storm last night.",
              "highlight": [
                "There was a storm"
              ],
              "explanation": "One storm, so there was."
            },
            {
              "sentence": "There were puddles everywhere this morning.",
              "highlight": [
                "There were puddles"
              ],
              "explanation": "Puddles is plural, so there were."
            }
          ]
        }
      ],
      "key_takeaway": "The same rule in the past.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 59,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Is There? Are There?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "In questions, is or are comes before there, but it still agrees with the noun after there.",
          "scope": "Questions",
          "examples": [
            {
              "sentence": "Is there a chemist near here?",
              "highlight": [
                "Is there a chemist"
              ],
              "explanation": "A chemist is singular, so is there."
            },
            {
              "sentence": "Are there any seats left?",
              "highlight": [
                "Are there any seats"
              ],
              "explanation": "Seats is plural, so are there."
            }
          ]
        }
      ],
      "key_takeaway": "In questions, the verb comes first.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 57,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A List After There",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "When a list follows there, the verb usually agrees with the first item.",
          "scope": "Lists",
          "examples": [
            {
              "sentence": "There is a pen and two pencils in my bag.",
              "highlight": [
                "There is a pen"
              ],
              "explanation": "The first item, a pen, is singular."
            }
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "Plural first",
          "text": "There are two pencils and a pen in my bag."
        }
      ],
      "key_takeaway": "The first item in the list decides.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 56,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "common_mistake",
      "pedagogical_role": "error_analysis",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "There's With a Plural",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "There's two buses to the city every hour.",
            "correct": "There are two buses to the city every hour.",
            "reason": "Buses is plural, so write there are. There's before a plural noun is common in speech, but not in writing."
          },
          "related_learning_objective_ids": [
            "OBJ003"
          ]
        }
      ],
      "key_takeaway": "In writing, plural nouns need there are.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 46,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "How Many and How Much",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "How many students are there in your class?",
              "highlight": [
                "are there"
              ],
              "explanation": "How many asks about a plural noun, so are."
            },
            {
              "sentence": "How much sugar is there in this tea?",
              "highlight": [
                "is there"
              ],
              "explanation": "How much asks about an uncountable noun, so is."
            }
          ]
        }
      ],
      "key_takeaway": "How many … are there; how much … is there.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
