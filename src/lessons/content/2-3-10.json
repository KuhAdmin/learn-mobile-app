      ],
      "title": "There Is and There Are: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "There is / was + singular or uncountable.",
            "There are / were + plural.",
            "Is there? Are there? follow the same rule.",
            "A list: the first item decides.",
            "In writing: there are, not there's, before a plural."
          ]
        }
      ],
      "key_takeaway": "Look past there to the real subject.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 38,
