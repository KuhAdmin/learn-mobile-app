    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Five Building Blocks",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "list",
          "introduction": "Sentences are built from these blocks:",
          "list_style": "bulleted",
          "items": [
            "Subject – who or what the sentence is about",
            "Verb – the action or state",
            "Object – what receives the action",
            "Complement – completes the subject or object",
            "Adverbial – tells how, where or when"
          ]
        }
      ],
      "key_takeaway": "Subject, verb, object, complement, adverbial.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Blocks in One Sentence",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "example",
          "examples": [
            {
              "sentence": "My cousin painted a mural at school last week.",
              "highlight": [
                "My cousin",
                "painted",
                "a mural",
                "at school last week"
              ],
              "explanation": "Subject, verb, object, then an adverbial of place and time."
            }
          ]
        }
      ],
      "key_takeaway": "Label each block in turn.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 31,
