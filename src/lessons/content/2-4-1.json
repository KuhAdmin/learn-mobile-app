  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "What Makes a Sentence?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A sentence has a subject and a verb, and it makes complete sense on its own."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The monsoon reached Kerala on Monday.",
              "highlight": [
                "The monsoon",
                "reached"
              ],
              "explanation": "The monsoon is the subject and reached is the verb. The idea is complete."
            }
          ]
        }
      ],
      "key_takeaway": "Subject, verb, complete sense.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 46,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Two Parts You Always Need",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "Every sentence needs a subject and a verb. Even a two-word sentence can be complete.",
          "scope": "Every sentence",
          "examples": [
            {
              "sentence": "Thunder rumbled.",
              "highlight": [
                "Thunder",
                "rumbled"
              ],
              "explanation": "A subject and a verb make a complete sentence."
            }
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Commands",
          "text": "In \"Sit down.\" the subject you is understood (2-4-2)."
        }
      ],
      "key_takeaway": "No subject or no verb: no sentence.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Complete Sense",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "A sentence must also make complete sense. If the words leave you waiting for more, the sentence isn't finished."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "When the bell rings, we line up.",
              "highlight": [
                "When the bell rings",
                "we line up"
              ],
              "explanation": "\"When the bell rings\" alone leaves you waiting; \"we line up\" finishes the idea."
            }
          ]
        }
      ],
      "key_takeaway": "If you're left waiting, it isn't finished.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 52,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Three Kinds of Fragment",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "list",
          "introduction": "A fragment looks like a sentence but is missing a part:",
          "list_style": "bulleted",
          "items": [
            "No subject: Ran to the gate.",
            "No verb: The tall boy with the kite.",
            "Not complete: Because it was raining."
          ]
        }
      ],
      "key_takeaway": "A fragment is missing something.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 36,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "common_mistake",
      "pedagogical_role": "error_analysis",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Fixing a Fragment",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "We stayed inside. Because it was raining.",
            "correct": "We stayed inside because it was raining.",
            "reason": "\"Because it was raining\" can't stand alone, so join it to the sentence before it."
          },
          "related_learning_objective_ids": [
            "OBJ002"
          ]
        }
      ],
      "key_takeaway": "Join the fragment to its sentence.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 37,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
