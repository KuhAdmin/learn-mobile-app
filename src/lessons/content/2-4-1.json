  "lesson": {
    "lesson_title": "Introduction to Sentence Construction",
    "lesson_summary": "A sentence has a subject and a verb and makes complete sense. Learners spot and fix fragments (no subject, no verb, or not complete), meet the five building blocks of a sentence (subject, verb, object, complement, adverbial), and see the path through this chapter. Kinds of sentence are left to Stage 2.5.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Say what makes a sentence.",
        "success_criteria": [
          "Check for a subject and a verb.",
          "Check that it makes complete sense."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Spot and fix fragments.",
        "success_criteria": [
          "Name what a fragment is missing.",
          "Join a fragment to a sentence."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Name the five building blocks.",
        "success_criteria": [
          "Find the subject, verb, object and adverbial in a sentence."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 9
  },
