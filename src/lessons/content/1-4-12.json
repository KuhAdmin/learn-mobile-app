  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "One at a Time, Before a Noun",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Each, every, either and neither can come before a noun to talk about the members of a group one at a time."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Every child got a sparkler at Diwali.",
              "highlight": [
                "Every child"
              ],
              "explanation": "Every child means all the children, thought of one by one."
            }
          ]
        }
      ],
      "key_takeaway": "Distributive determiners go member by member.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "A Singular Noun Follows",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Each, every, either and neither come before a singular noun.",
          "scope": "Distributive determiners",
          "examples": [
            {
              "sentence": "Each player wore a numbered shirt.",
              "highlight": [
                "Each player"
              ],
              "explanation": "Each is followed by the singular noun player."
            },
            {
              "sentence": "Neither shop had my size.",
              "highlight": [
                "Neither shop"
              ],
              "explanation": "Neither is followed by the singular noun shop."
            }
          ]
        },
        {
          "block_id": "BLOCK005",
          "type": "note",
          "title": "Meanings",
          "text": "Each, either and neither mean the same as the pronouns in 1-3-11."
        }
      ],
      "key_takeaway": "Each player, not each players.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Each or Every?",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "comparison",
          "items": [
            {
              "label": "Each",
              "description": "One by one; the group can be two or more.",
              "example": "The teacher spoke to each student in turn."
            },
            {
              "label": "Every",
              "description": "All of them together; usually three or more.",
              "example": "Every student in our class passed the test."
            }
          ],
          "comparison_points": [
            "In the first sentence, the teacher talks to students one at a time.",
            "In the second, we mean the whole class."
          ],
          "conclusion": "Use each for one by one, and every for all of them."
        }
      ],
      "key_takeaway": "Each is one by one; every is all together.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Every for Repeated Times",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "Every + a time word tells how often something happens."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "We visit Nani every Sunday.",
              "highlight": [
                "every Sunday"
              ],
              "explanation": "The visit happens on all Sundays, again and again."
            },
            {
              "sentence": "Take this syrup every six hours.",
              "highlight": [
                "every six hours"
              ],
              "explanation": "One dose, then another six hours later, and so on."
            }
          ]
        }
      ],
      "key_takeaway": "Every Sunday tells how often.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ004"
      ],
      "title": "Every Other, Every Single",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "Every other + noun means every second one. Every single adds emphasis: not one is left out."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "Our cousins visit every other Sunday.",
              "highlight": [
                "every other Sunday"
              ],
              "explanation": "They come one Sunday, skip the next, and come again."
            },
            {
              "sentence": "I checked every single pocket for my keys.",
              "highlight": [
                "every single"
              ],
              "explanation": "Every single stresses that no pocket was missed."
            }
          ]
        },
        {
          "block_id": "BLOCK012",
          "type": "note",
          "title": "Also",
          "text": "On either side of the lane means on both sides."
        }
      ],
      "key_takeaway": "Every other is every second one; every single stresses all.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
