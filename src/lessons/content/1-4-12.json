      "title": "Distributive Determiners: Recap",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Each, every, either and neither + a singular noun.",
            "Each: one by one. Every: all together.",
            "Either: one of two. Neither: not one of two.",
            "Every + time word: how often.",
            "Every other: every second one. Every single: all, with emphasis."
          ]
        }
      ],
      "key_takeaway": "Take the group one member at a time.",
