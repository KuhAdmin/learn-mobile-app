  "lesson": {
    "lesson_title": "Distributive Determiners",
    "lesson_summary": "Learners already know each, either and neither standing alone (1-3-11). This lesson uses each, every, either and neither before a singular noun. It recalls their meanings from 1-3-11, compares each (one by one, two or more) with every (the whole group, three or more), and uses every with time words to say how often. Verb agreement with these words is left to Stage 2.3. It also teaches the fixed phrases every other (every second one), every single (emphasis) and on either side (on both sides).",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use each and every before a singular noun.",
        "success_criteria": [
          "Use a singular noun after each and every.",
          "Tell each from every."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use either and neither before a noun for two.",
        "success_criteria": [
          "Choose either or neither by meaning."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use every with time words.",
        "success_criteria": [
          "Say every Monday and every two hours."
        ]
      },
      {
        "objective_id": "OBJ004",
        "description": "Use the fixed phrases every other, every single and on either side.",
        "success_criteria": [
          "Explain every other day.",
          "Use every single for emphasis."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 6
  },
