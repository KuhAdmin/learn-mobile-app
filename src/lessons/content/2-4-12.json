              ],
              "explanation": "Them comes first, then for + the person."
            },
            {
              "sentence": "Can you show it to the class?",
              "highlight": [
                "it to the class"
              ],
              "explanation": "It comes first, then to + the people."
            }
          ]
        }
      ],
      "key_takeaway": "Pronoun first, person after.",
      "page_audit": {
        "primary_objective_count": 1,
