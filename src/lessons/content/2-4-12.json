  "lesson": {
    "lesson_title": "Subject–Verb–Indirect Object–Direct Object Pattern",
    "lesson_summary": "An SVOO sentence (2-4-4) can often be said another way: the thing first, then to or for + the person. Learners rewrite between the two patterns, choose to (give, send, lend, show) or for (buy, make, cook, get), use the to / for pattern when the thing is a pronoun (Give it to me.), and use to with verbs that never take the person first: explain, describe, suggest, say.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Rewrite SVOO sentences with to or for.",
        "success_criteria": [
          "Move the person after to or for.",
          "Choose to or for."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use the to / for pattern with pronoun objects.",
        "success_criteria": [
          "Say give it to me."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use to with explain, describe, suggest and say.",
        "success_criteria": [
          "Avoid explain me the rule."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
