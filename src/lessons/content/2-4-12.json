    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Explain, Describe, Suggest, Say",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "Explain, describe, suggest and say never take the person first. Put the thing first and use to.",
          "scope": "Verbs that need to",
          "examples": [
            {
              "sentence": "Could you explain the rule to me?",
              "highlight": [
                "the rule to me"
              ],
              "explanation": "Explain needs to before the person."
            }
          ]
        },
        {
          "block_id": "BLOCK009",
          "type": "note",
          "title": "Not this",
          "text": "Could you explain me the rule?"
        }
      ],
      "key_takeaway": "These verbs always use to.",
