      "content": [
        {
          "block_id": "BLOCK011",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Give her the book = give the book to her.",
            "To: give, send, lend, show. For: buy, make, cook, get.",
            "Pronoun thing: give it to me.",
            "Explain, describe, suggest, say: always to."
          ]
        }
