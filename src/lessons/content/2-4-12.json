  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Two Ways to Say It",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "An SVOO sentence (2-4-4) can often be said another way: put the thing first, then to or for + the person."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Nikhil lent his neighbour a ladder.",
              "highlight": [
                "his neighbour a ladder"
              ],
              "explanation": "Person first, then the thing."
            },
            {
              "sentence": "Nikhil lent a ladder to his neighbour.",
              "highlight": [
                "a ladder to his neighbour"
              ],
              "explanation": "Thing first, then to + the person."
            }
          ]
        }
      ],
      "key_takeaway": "Person first, or thing first with to or for.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 61,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Move the Person After To",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "To rewrite, put the thing straight after the verb and the person after to.",
          "scope": "Rewriting",
          "examples": [
            {
              "sentence": "The coach threw the ball to Arjun.",
              "highlight": [
                "the ball to Arjun"
              ],
              "explanation": "The same as: The coach threw Arjun the ball."
            }
          ]
        }
      ],
      "key_takeaway": "Thing, then to + person.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 43,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "To or For?",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Use to when the thing goes to someone: give, send, lend, show. Use for when you do something for someone: buy, make, cook, get.",
          "scope": "Choosing",
          "examples": [
            {
              "sentence": "Ammu sent a letter to her pen pal.",
              "highlight": [
                "to her pen pal"
              ],
              "explanation": "The letter goes to someone, so to."
            },
            {
              "sentence": "Papa cooked dinner for the guests.",
              "highlight": [
                "for the guests"
              ],
              "explanation": "Papa did the cooking for them, so for."
            }
          ]
        }
      ],
      "key_takeaway": "Goes to someone: to. Done for someone: for.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 67,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Give It to Me",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "When the thing is a pronoun such as it or them, use the to or for pattern.",
          "scope": "Pronoun direct objects",
          "examples": [
            {
              "sentence": "Please pass it to Grandpa.",
              "highlight": [
                "it to Grandpa"
              ],
              "explanation": "It comes first, then to + the person."
            }
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "note",
          "title": "Not this",
          "text": "Please pass Grandpa it."
        }
      ],
      "key_takeaway": "Thing is a pronoun? Use to or for.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 50,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
