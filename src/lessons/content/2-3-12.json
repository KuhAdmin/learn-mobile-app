  "lesson": {
    "lesson_title": "Agreement with Titles, Names and Measurements",
    "lesson_summary": "Some subjects look plural but name one thing or one amount, so they take a singular verb: titles of books and films (The Three Musketeers tells…), names of places that look plural (The Philippines is…), amounts of money, distance and time (Five hundred rupees is…), and sums in maths (Two plus three is five). Always-plural nouns were taught in 2-3-2.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use a singular verb after titles and plural-looking names.",
        "success_criteria": [
          "Choose is after a book title or a country name ending in -s."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use a singular verb for one amount.",
        "success_criteria": [
          "Treat money, distance and time as one amount.",
          "Tell one amount from separate things."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use a singular verb in sums.",
        "success_criteria": [
          "Say two plus three is five."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
