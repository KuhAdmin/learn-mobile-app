      "title": "One Name, One Amount",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Some subjects look plural but name one thing or one amount. They take a singular verb."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Little Women is my favourite novel.",
              "highlight": [
                "Little Women is"
              ],
              "explanation": "Little Women is the title of one book."
            }
          ]
        }
      ],
      "key_takeaway": "Looks plural, means one: singular verb.",
