      ],
      "title": "Names That Look Plural",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Names of countries and places that end in -s usually take a singular verb.",
          "scope": "Place names",
          "examples": [
            {
              "sentence": "The Philippines is a country of many islands.",
              "highlight": [
                "The Philippines is"
              ],
              "explanation": "The Philippines is one country."
            },
            {
              "sentence": "The United States has fifty states.",
              "highlight": [
                "The United States has"
              ],
              "explanation": "The United States is one country, so has."
            }
          ]
        },
        {
          "block_id": "BLOCK005",
          "type": "note",
          "title": "Shop names",
          "text": "Shop names often work the same way: Sharma Sweets is open late."
        }
      ],
      "key_takeaway": "One country, one verb.",
