      "title": "One Amount, Singular Verb",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "When a plural measurement of money, distance, time or weight means one amount, the verb is singular.",
          "scope": "Measurements",
          "examples": [
            {
              "sentence": "Five hundred rupees is too much for a T-shirt.",
              "highlight": [
                "Five hundred rupees is"
              ],
              "explanation": "Five hundred rupees is one price."
            },
            {
              "sentence": "Ten kilometres is a long way to walk.",
              "highlight": [
                "Ten kilometres is"
              ],
              "explanation": "Ten kilometres is one distance."
            }
          ]
        }
      ],
      "key_takeaway": "Five hundred rupees is; ten kilometres is.",
