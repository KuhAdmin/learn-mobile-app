      "title": "One Amount or Separate Things?",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "comparison",
          "items": [
            {
              "label": "One amount",
              "description": "A singular verb.",
              "example": "Fifty rupees is the price of the ticket."
            },
            {
              "label": "Separate coins",
              "description": "A plural verb.",
              "example": "Fifty one-rupee coins are in the jar."
            }
          ],
          "comparison_points": [
            "In the first sentence, the money is one price.",
            "In the second, we are counting separate coins."
          ],
          "conclusion": "Ask whether you mean one total or many separate things."
        }
      ],
      "key_takeaway": "An amount: singular. Separate items: plural.",
