      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Titles Are Singular",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "The title of a book, film, song or game takes a singular verb, even if it looks plural.",
          "scope": "Titles",
          "examples": [
            {
              "sentence": "Gulliver's Travels is a funny book.",
              "highlight": [
                "Gulliver's Travels is"
              ],
              "explanation": "It is one book, so the verb is is."
            },
            {
              "sentence": "The Three Musketeers tells the story of four friends.",
              "highlight": [
                "The Three Musketeers tells"
              ],
              "explanation": "One story, so tells has -s."
            }
          ]
        }
      ],
      "key_takeaway": "One book or film: singular verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 62,
