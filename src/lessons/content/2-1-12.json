  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "A Verb Plus a Small Word",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A verb plus a small word such as up, off, out or after can make a new meaning. These are phrasal verbs."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Please don't give up on the puzzle now.",
              "highlight": [
                "give up"
              ],
              "explanation": "Give up means stop trying, which is not the meaning of give or up alone."
            }
          ]
        }
      ],
      "key_takeaway": "Verb + small word can mean something new.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Ordinary Meaning or New Meaning?",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "comparison",
          "items": [
            {
              "label": "Ordinary meaning",
              "description": "The words mean what they say.",
              "example": "The boy looked up at the stars."
            },
            {
              "label": "New meaning",
              "description": "The words together mean something else.",
              "example": "The boy looked up the word in a dictionary."
            }
          ],
          "comparison_points": [
            "In the first sentence, the boy raises his eyes.",
            "In the second, he searches for information."
          ],
          "conclusion": "A phrasal verb often has a meaning you can't guess from its parts."
        }
      ],
      "key_takeaway": "Look up can mean search.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Everyday Phrasal Verbs",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "give up – stop trying",
            "look after – take care of",
            "turn down – refuse, or make quieter",
            "find out – discover",
            "run out of – have none left",
            "get on with – be friendly with"
          ]
        }
      ],
      "key_takeaway": "Learn phrasal verbs with their meanings.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Moving the Small Word",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "With many phrasal verbs, a noun object can go after the small word or between the two parts: switch off the fan, switch the fan off.",
          "scope": "Separable phrasal verbs with a noun object",
          "examples": [
            {
              "sentence": "Please switch the fan off before you leave.",
              "highlight": [
                "switch the fan off"
              ],
              "explanation": "The noun the fan sits between switch and off."
            }
          ]
        }
      ],
      "key_takeaway": "A noun can go in the middle or at the end.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Pronouns Go in the Middle",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "If the object is a pronoun (it, them, her), it must go between the verb and the small word.",
          "scope": "Separable phrasal verbs with a pronoun object",
          "examples": [
            {
              "sentence": "The radio is too loud, so turn it down.",
              "highlight": [
                "turn it down"
              ],
              "explanation": "It goes in the middle: turn it down, not turn down it."
            }
          ]
        }
      ],
      "key_takeaway": "Turn it down, never turn down it.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
