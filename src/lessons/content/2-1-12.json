  "lesson": {
    "lesson_title": "Phrasal Verbs – Introduction",
    "lesson_summary": "Learners meet phrasal verbs: a verb plus a small word such as up, off, out or after, often with a new meaning (give up, look after, find out). They learn common everyday phrasal verbs, that a noun object can often go before or after the small word, and that a pronoun object must go in the middle ('turn it off'). A full phrasal-verb list comes in later stages.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise phrasal verbs and their meanings.",
        "success_criteria": [
          "Tell a literal meaning from a new meaning.",
          "Explain common phrasal verbs."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Place the object of a phrasal verb.",
        "success_criteria": [
          "Put a noun before or after the small word.",
          "Put a pronoun in the middle."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
