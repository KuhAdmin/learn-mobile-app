  "lesson": {
    "lesson_title": "Demonstrative Pronouns",
    "lesson_summary": "Learners use this, that, these and those as pronouns that point at something and stand in for its name. They choose by distance (near or far) and number (one or more), tell a pronoun standing alone from the same word before a noun, and see that this and that can point back to a whole idea. The before-a-noun use is taught in 1-4-9.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose this, that, these or those by distance and number.",
        "success_criteria": [
          "Use this and these for near things.",
          "Use that and those for far things."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Tell a demonstrative pronoun from the same word before a noun.",
        "success_criteria": [
          "Spot whether a noun follows the word."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use this and that to point back to an idea.",
        "success_criteria": [
          "Say what that refers to in 'That was kind of you.'"
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 7
  },
