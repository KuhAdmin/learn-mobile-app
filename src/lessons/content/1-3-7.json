  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Pointing Words",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "This, that, these and those can point at something and stand in for its name, like a finger pointing in words."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "That smells delicious!",
              "highlight": [
                "That"
              ],
              "explanation": "That points at a dish we can see, so we don't need to name it."
            }
          ]
        }
      ],
      "key_takeaway": "Demonstrative pronouns point at things.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Near or Far, One or Many",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Choose by distance and by number:",
          "list_style": "bulleted",
          "items": [
            "this – one thing, near",
            "these – more than one, near",
            "that – one thing, far",
            "those – more than one, far"
          ]
        }
      ],
      "key_takeaway": "Near: this, these. Far: that, those.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Close By: This and These",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "Use this for one thing near you and these for more than one."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "This is my favourite spot in the park.",
              "highlight": [
                "This"
              ],
              "explanation": "The speaker is at the spot, and it is one place: this."
            },
            {
              "sentence": "These are the keys to the garden shed.",
              "highlight": [
                "These"
              ],
              "explanation": "The keys are in the speaker's hand, and there are several: these."
            }
          ]
        }
      ],
      "key_takeaway": "This and these point at things close by.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Far Away: That and Those",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Use that for one thing farther away and those for more than one."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Is that a hawk on the lamp post?",
              "highlight": [
                "that"
              ],
              "explanation": "The bird is far off, and there is one: that."
            },
            {
              "sentence": "Those were the sweetest mangoes of the summer.",
              "highlight": [
                "Those"
              ],
              "explanation": "The mangoes are in the past and there were many: those."
            }
          ]
        }
      ],
      "key_takeaway": "That and those point at things farther away.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Alone or Before a Noun?",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "comparison",
          "items": [
            {
              "label": "Standing alone",
              "description": "A pronoun: it replaces the noun.",
              "example": "This is heavy."
            },
            {
              "label": "Before a noun",
              "description": "A pointer word that goes with a noun.",
              "example": "This box is heavy."
            }
          ],
          "comparison_points": [
            "In the first sentence, this stands for the box.",
            "In the second, this comes before box. That use is taught in Chapter 1.4."
          ],
          "conclusion": "If no noun follows, this, that, these and those are pronouns."
        }
      ],
      "key_takeaway": "No noun after it? It's a demonstrative pronoun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 50,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Pointing Back at an Idea",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "text",
          "text": "This and that can also point back at a whole action or idea, not just a thing."
        },
        {
          "block_id": "BLOCK010",
          "type": "example",
          "examples": [
            {
              "sentence": "You carried my bags all the way home. That was kind of you.",
              "highlight": [
                "That"
              ],
              "explanation": "That means carrying the bags home: a whole action."
            }
          ]
        }
      ],
      "key_takeaway": "That can stand for a whole action.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Demonstrative Pronouns: Recap",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "This and these: near. That and those: far.",
            "This and that: one. These and those: more than one.",
            "Standing alone, they are pronouns.",
            "This and that can point back at an idea."
          ]
        }
      ],
      "key_takeaway": "Point with this, that, these or those.",
