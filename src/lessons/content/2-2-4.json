  "lesson": {
    "lesson_title": "Adverbs of Place",
    "lesson_summary": "Adverbs of place answer \"where?\". Learners meet everyday place adverbs, use home and abroad without to, add direction adverbs and the -where family (somewhere, anywhere, everywhere, nowhere), and place these adverbs after the verb or object, with here and there at the start for a lively effect. Prepositions of place are left to Stage 4.1.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise adverbs of place.",
        "success_criteria": [
          "Find the word that tells where.",
          "Say go home, not go to home."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use direction adverbs and the -where words.",
        "success_criteria": [
          "Find a direction adverb.",
          "Choose somewhere, anywhere or everywhere."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Place adverbs of place correctly.",
        "success_criteria": [
          "Put them after the verb or object.",
          "Use Here comes… correctly."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
