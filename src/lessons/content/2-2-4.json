  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Where Does It Happen?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Adverbs of place tell us where something happens."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The twins are playing outside.",
              "highlight": [
                "outside"
              ],
              "explanation": "Outside tells where the twins are playing."
            }
          ]
        }
      ],
      "key_takeaway": "Place adverbs tell where.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 29,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Everyday Place Adverbs",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Each of these answers \"where?\":",
          "list_style": "bulleted",
          "items": [
            "here",
            "there",
            "upstairs",
            "downstairs",
            "abroad",
            "nearby",
            "away",
            "outside",
            "home"
          ]
        }
      ],
      "key_takeaway": "Learn the common place words.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 12,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Go Home, Not Go to Home",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "After a verb of movement, home is a place adverb, so it takes no to.",
          "scope": "go, come, walk, drive + home",
          "examples": [
            {
              "sentence": "It's getting dark, so let's go home.",
              "highlight": [
                "home"
              ],
              "explanation": "Home already means \"to your house\", so no to is needed."
            }
          ]
        },
        {
          "block_id": "BLOCK005",
          "type": "note",
          "title": "Same pattern",
          "text": "Go abroad, run upstairs, come downstairs: no to before these either."
        }
      ],
      "key_takeaway": "No to before home or abroad.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 63,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Which Way?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Some place adverbs show direction: up, down, back, forward, backwards, away."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Step back from the edge of the platform.",
              "highlight": [
                "back"
              ],
              "explanation": "Back shows which way to move."
            },
            {
              "sentence": "The lift is going down.",
              "highlight": [
                "down"
              ],
              "explanation": "Down shows the direction of the lift."
            }
          ]
        }
      ],
      "key_takeaway": "Direction adverbs show which way.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Somewhere, Anywhere, Everywhere",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "Somewhere, anywhere, everywhere and nowhere work like someone and anyone, but for places."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "I can't find my house keys anywhere.",
              "highlight": [
                "anywhere"
              ],
              "explanation": "Anywhere is used in a negative sentence."
            },
            {
              "sentence": "There were balloons everywhere at the party.",
              "highlight": [
                "everywhere"
              ],
              "explanation": "Everywhere means in every place."
            }
          ]
        },
        {
          "block_id": "BLOCK010",
          "type": "note",
          "title": "Nowhere",
          "text": "Nowhere means \"not anywhere\": There was nowhere to sit."
        }
      ],
      "key_takeaway": "Some- in statements, any- in questions.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 60,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "After the Verb or Object",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "rule",
          "rule_id": "RULE011",
          "rule_text": "A place adverb usually goes after the verb, or after the object if there is one.",
          "scope": "Usual position",
          "examples": [
            {
              "sentence": "Please put the boxes downstairs.",
              "highlight": [
                "downstairs"
              ],
              "explanation": "Downstairs comes after the object the boxes."
            }
          ]
        }
      ],
      "key_takeaway": "Place usually follows the verb or object.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Here Comes the Bus!",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "text",
          "text": "Here and there can start a lively sentence. With a noun, the verb comes before it."
        },
        {
          "block_id": "BLOCK013",
          "type": "example",
          "examples": [
            {
              "sentence": "Here comes the bus!",
              "highlight": [
                "Here comes"
              ],
              "explanation": "The verb comes goes before the noun the bus."
            },
            {
              "sentence": "There goes our kite!",
              "highlight": [
                "There goes"
              ],
              "explanation": "There goes shows the kite moving away."
            }
          ]
        },
        {
          "block_id": "BLOCK014",
          "type": "note",
          "title": "With a pronoun",
          "text": "Keep the normal order: Here it comes!"
        }
      ],
      "key_takeaway": "Here comes + noun; here it comes.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 64,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Place Adverbs: Recap",
      "content": [
        {
          "block_id": "BLOCK015",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Place adverbs answer \"where?\".",
            "Go home and go abroad take no to.",
            "Direction: up, down, back, forward.",
            "Somewhere in statements; anywhere in questions and negatives.",
            "Place goes after the verb or object."
          ]
        }
      ],
      "key_takeaway": "Tell where, after the verb or object.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 34,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    }
