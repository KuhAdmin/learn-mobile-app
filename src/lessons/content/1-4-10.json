  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "Starting a Noun Group With an Owner",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A possessive determiner such as our, or a possessive noun such as Ravi's, starts a noun group and tells whose it is."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Ravi's kite got stuck in our mango tree.",
              "highlight": [
                "Ravi's",
                "our"
              ],
              "explanation": "Ravi's tells whose kite; our tells whose mango tree."
            }
          ]
        }
      ],
      "key_takeaway": "An owner word can start a noun group.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Owner, Describing Word, Noun",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "The possessive comes first, then any describing words, then the noun.",
          "scope": "Possessive determiners in a noun group",
          "examples": [
            {
              "sentence": "Her bright red umbrella kept us dry.",
              "highlight": [
                "Her bright red umbrella"
              ],
              "explanation": "Her comes first, then bright and red, then umbrella."
            }
          ]
        }
      ],
      "key_takeaway": "The owner word goes first.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "common_mistake",
      "pedagogical_role": "error_analysis",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Never Next to A or The",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "A possessive determiner never sits next to a, an, the or this. Choose one of them."
        },
        {
          "block_id": "BLOCK005",
          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "I bumped into a my friend at the market.",
            "correct": "I bumped into a friend of mine at the market.",
            "reason": "A and my can't go together. Say 'my friend', or 'a friend of mine' for one of your friends."
          },
          "related_learning_objective_ids": [
            "OBJ001"
          ]
        }
      ],
      "key_takeaway": "My or a, never both together.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A Name as the Owner",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "A possessive noun with 's works like a determiner too. It starts the noun group and tells whose."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Tara's lunchbox fell into the puddle.",
              "highlight": [
                "Tara's"
              ],
              "explanation": "Tara's starts the noun group and tells whose lunchbox."
            }
          ]
        }
      ],
      "key_takeaway": "Tara's works like her: it shows the owner.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Their Own",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "Add own after a possessive to stress that something belongs to that person alone."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "The twins finally have their own bedrooms.",
              "highlight": [
                "their own"
              ],
              "explanation": "Their own stresses that each twin no longer shares a room."
            }
          ]
        }
      ],
      "key_takeaway": "My own means mine and nobody else's.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Body Parts and Clothes Take an Owner Word",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "With body parts, clothes and personal things, English uses my, your, her and the other possessives, not the.",
          "scope": "Body parts, clothes and belongings",
          "examples": [
            {
              "sentence": "Kavya brushed her hair before school.",
              "highlight": [
                "her hair"
              ],
              "explanation": "The hair is Kavya's own, so her."
            },
            {
              "sentence": "Take off your shoes at the temple door.",
              "highlight": [
                "your shoes"
              ],
              "explanation": "The shoes belong to the listener, so your."
            }
          ]
        }
      ],
      "key_takeaway": "My hand, your shoes, never the hand.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Possessive Determiners: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Owner word, describing words, noun: my old bike.",
            "Never with a, the or this: a friend of mine.",
            "A possessive noun works the same way: Tara's lunchbox.",
            "Own adds stress: their own room.",
            "Body parts and clothes take a possessive: my ankle, your shoes."
          ]
        }
      ],
      "key_takeaway": "One owner word starts the noun group.",
