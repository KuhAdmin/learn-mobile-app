  "lesson": {
    "lesson_title": "Possessive Determiners",
    "lesson_summary": "Learners already know my, your, his, her, its, our and their before a noun (1-3-4). This lesson places them inside a noun group: possessive first, then describing words, then the noun. They learn that a possessive never sits next to a, the or this ('a friend of mine', not 'a my friend'), that a possessive noun such as Tara's works the same way, and that own can follow a possessive. It also shows that English uses a possessive with body parts and clothes ('She hurt her knee', 'Take off your shoes').",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Place a possessive determiner in a noun group.",
        "success_criteria": [
          "Put the possessive before describing words.",
          "Never use it with a, the or this."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use possessive nouns and own as part of the noun group.",
        "success_criteria": [
          "Use Tara's as a determiner.",
          "Say their own room."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use a possessive with body parts and clothes.",
        "success_criteria": [
          "Say 'I hurt my ankle', not 'I hurt the ankle'.",
          "Say 'Take off your shoes'."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
