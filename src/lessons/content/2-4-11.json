      "title": "A Noun Complement Matches the Subject",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "A noun complement matches the subject in number: a plural subject takes a plural noun.",
          "scope": "Number",
          "examples": [
            {
              "sentence": "The two girls became best friends.",
              "highlight": [
                "became best friends"
              ],
              "explanation": "Two girls, so friends is plural."
            }
          ]
        }
      ],
      "key_takeaway": "Two girls became friends, not friend.",
