      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A Noun or an Adjective?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "comparison",
          "items": [
            {
              "label": "With a noun",
              "description": "Says what the subject is.",
              "example": "Our neighbour became a police officer."
            },
            {
              "label": "With an adjective",
              "description": "Says what the subject is like.",
              "example": "Our neighbour became famous."
            }
          ],
          "comparison_points": [
            "In the first sentence, the complement names a job.",
            "In the second, it describes the neighbour."
          ],
          "conclusion": "Choose the complement that says what you mean."
        }
      ],
      "key_takeaway": "A noun says what; an adjective says what like.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 57,
        "density_status": "passed",
        "standalone_understanding": "passed"
