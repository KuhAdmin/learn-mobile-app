      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Build With Be, Seem and Look",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "Be, seem and look link the subject to how it is or seems.",
          "scope": "be, seem, look",
          "examples": [
            {
              "sentence": "The new library seems huge.",
              "highlight": [
                "seems huge"
              ],
              "explanation": "Seems links the library to huge."
            }
          ]
        }
      ],
      "key_takeaway": "Be, seem, look + complement.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Build With Change Verbs",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Become, get, turn and grow link the subject to a new state.",
          "scope": "Change verbs",
          "examples": [
            {
              "sentence": "The puppy grew strong on the farm.",
              "highlight": [
                "grew strong"
              ],
              "explanation": "The puppy changed, so grow is linking here."
            },
            {
              "sentence": "The sky got dark at four o'clock.",
              "highlight": [
                "got dark"
              ],
              "explanation": "Got shows the sky changed."
            }
          ]
        }
      ],
      "key_takeaway": "Become, get, turn, grow show a change.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 52,
        "density_status": "passed",
        "standalone_understanding": "passed"
