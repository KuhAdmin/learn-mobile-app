      "title": "Subject, Linking Verb, Complement",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "The SVC pattern uses a linking verb (2-1-4) and a subject complement (2-4-5)."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The rooftop garden looks beautiful.",
              "highlight": [
                "The rooftop garden looks beautiful"
              ],
              "explanation": "Subject, linking verb, complement."
            }
          ]
        }
      ],
      "key_takeaway": "SVC: the verb links the subject to its complement.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 33,
        "density_status": "passed",
