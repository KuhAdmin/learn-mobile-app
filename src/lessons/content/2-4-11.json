      ],
      "title": "Add an Adverbial",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "Add how, where or when to an SVC sentence and it stays SVC.",
          "scope": "SVC + adverbials",
          "examples": [
            {
              "sentence": "Grandma felt tired after the long wedding.",
              "highlight": [
                "Grandma felt tired"
              ],
              "explanation": "After the long wedding is an extra."
            }
          ]
        }
      ],
      "key_takeaway": "Extras don't change SVC.",
