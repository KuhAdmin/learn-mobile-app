  "lesson": {
    "lesson_title": "Subject–Verb–Complement Pattern",
    "lesson_summary": "The SVC pattern uses a linking verb (2-1-4) and a subject complement (2-4-5). Learners build SVC sentences with be, seem and look and with the change verbs become, get, turn and grow; choose a noun or an adjective complement for the meaning; make a noun complement match the subject in number; and add adverbials without changing the pattern.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Build SVC sentences with linking verbs.",
        "success_criteria": [
          "Use be, seem and look.",
          "Use become, get, turn and grow for a change."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Choose a noun or adjective complement.",
        "success_criteria": [
          "Pick the complement for the meaning.",
          "Make a noun complement match the subject."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Add adverbials to SVC sentences.",
        "success_criteria": [
          "Find the SVC core of a longer sentence."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
