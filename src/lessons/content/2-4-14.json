  "lesson": {
    "lesson_title": "Normal and Inverted Word Order",
    "lesson_summary": "In normal order the subject comes before the verb; in inverted order a verb, usually a helper, comes first. Learners recall the inversion they know (questions; here and there, 2-2-4), invert after a negative word at the start (Never have I…, Rarely does she…, Not only did…), and use so, neither and nor + helper + subject to agree (So do I. / Neither can Ravi.). Questions in full are left to 2-4-16.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Tell normal from inverted order.",
        "success_criteria": [
          "Spot the verb before the subject."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Invert after a negative opener.",
        "success_criteria": [
          "Use never, rarely and not only at the start."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Agree with so, neither and nor.",
        "success_criteria": [
          "Reply with so do I or neither can I."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
