  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Subject First, or Verb First?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "In normal order, the subject comes before the verb. In inverted order, a verb, often a helper, comes before the subject."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Never have I seen such a big kite!",
              "highlight": [
                "have I"
              ],
              "explanation": "The helper have comes before the subject I."
            }
          ]
        }
      ],
      "key_takeaway": "Inverted order puts a verb before the subject.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Normal Order",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "In most statements, the subject comes first and the verb follows.",
          "scope": "Normal order",
          "examples": [
            {
              "sentence": "The postwoman delivers our letters at ten.",
              "highlight": [
                "The postwoman delivers"
              ],
              "explanation": "Subject, then verb."
            }
          ]
        }
      ],
      "key_takeaway": "Most statements: subject, then verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 31,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Inversion You Already Know",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "You have already met inverted order in questions and after here and there (Here comes the bus!, 2-2-4)."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "Is your brother at home?",
              "highlight": [
                "Is your brother"
              ],
              "explanation": "The verb is comes before the subject your brother."
            }
          ]
        }
      ],
      "key_takeaway": "Questions and here or there invert.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Never, Rarely, Seldom at the Start",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "When never, rarely, seldom or hardly ever starts a sentence, put the helper before the subject. With no helper, use do, does or did.",
          "scope": "Negative openers",
          "examples": [
            {
              "sentence": "Rarely does Grandpa miss his evening walk.",
              "highlight": [
                "does Grandpa miss"
              ],
              "explanation": "Does comes before the subject Grandpa."
            },
            {
              "sentence": "Never have we had so much rain.",
              "highlight": [
                "have we had"
              ],
              "explanation": "Have comes before the subject we."
            }
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "Formal",
          "text": "This order sounds formal. Normal order is fine in everyday speech: We have never had so much rain."
        }
      ],
      "key_takeaway": "Negative opener, then helper, then subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 88,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Not Only … But Also",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "Not only at the start also takes inverted order.",
          "scope": "not only",
          "examples": [
            {
              "sentence": "Not only did Meera win the race, but she also broke the record.",
              "highlight": [
                "did Meera win"
              ],
              "explanation": "Did comes before the subject Meera."
            }
          ]
        }
      ],
      "key_takeaway": "Not only + helper + subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "So Do I",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "rule",
          "rule_id": "RULE009",
          "rule_text": "To agree with a positive sentence, use so + helper + subject. Use the same helper, or do, does or did.",
          "scope": "Agreeing",
          "examples": [
            {
              "sentence": "\"I love mango ice cream.\" \"So do I!\"",
              "highlight": [
                "So do I"
              ],
              "explanation": "The helper do comes before the subject I."
            }
          ]
        }
      ],
      "key_takeaway": "Agree with a positive: so + helper + subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Neither Can Ravi",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "rule",
          "rule_id": "RULE010",
          "rule_text": "To agree with a negative sentence, use neither or nor + helper + subject.",
          "scope": "Agreeing with a negative",
          "examples": [
            {
              "sentence": "\"I can't whistle.\" \"Neither can Ravi.\"",
              "highlight": [
                "Neither can Ravi"
              ],
              "explanation": "The helper can comes before the subject Ravi."
            }
          ]
        }
      ],
      "key_takeaway": "Agree with a negative: neither or nor + helper + subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
