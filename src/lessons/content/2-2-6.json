  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "How Much?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Adverbs of degree tell us how much, or to what degree."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The tea is extremely hot.",
              "highlight": [
                "extremely"
              ],
              "explanation": "Extremely tells how hot the tea is."
            }
          ]
        }
      ],
      "key_takeaway": "Degree adverbs tell how much.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "From a Little to a Lot",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "From weaker to stronger:",
          "list_style": "bulleted",
          "items": [
            "slightly, a bit – a little",
            "fairly, quite – more than a little",
            "rather – more than expected",
            "very, really – a lot",
            "extremely – a great deal",
            "almost – not quite all the way",
            "completely, totally – all the way"
          ]
        }
      ],
      "key_takeaway": "Pick the degree that fits.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 41,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Before an Adjective or Adverb",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "A degree adverb usually comes just before the adjective or adverb it describes."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "The maths puzzle was fairly easy.",
              "highlight": [
                "fairly"
              ],
              "explanation": "Fairly describes the adjective easy."
            },
            {
              "sentence": "Our new ceiling fan runs really quietly.",
              "highlight": [
                "really"
              ],
              "explanation": "Really describes the adverb quietly."
            }
          ]
        }
      ],
      "key_takeaway": "Degree comes before the word it changes.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Very or Too?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "Very",
              "description": "A lot, but still fine.",
              "example": "The box is very heavy, but I can lift it."
            },
            {
              "label": "Too",
              "description": "More than is wanted, so there is a problem.",
              "example": "The box is too heavy for me to lift."
            }
          ],
          "comparison_points": [
            "In the first sentence, the box is heavy and the speaker can still lift it.",
            "In the second, the weight stops the speaker."
          ],
          "conclusion": "Use too only when the amount causes a problem."
        }
      ],
      "key_takeaway": "Very is a lot; too is a problem.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 71,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Too Before the Adjective",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "Too goes before an adjective or adverb. A phrase with for or to often follows and names the problem.",
          "scope": "too + adjective",
          "examples": [
            {
              "sentence": "The river is too cold for a swim.",
              "highlight": [
                "too cold"
              ],
              "explanation": "Too cold says the cold is a problem; for a swim names it."
            }
          ]
        }
      ],
      "key_takeaway": "Too + adjective, then for or to.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 51,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Enough Comes After",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "As a degree adverb, enough goes after the adjective or adverb.",
          "scope": "adjective + enough",
          "examples": [
            {
              "sentence": "Is the rope long enough?",
              "highlight": [
                "long enough"
              ],
              "explanation": "Enough follows the adjective long."
            }
          ]
        },
        {
          "block_id": "BLOCK009",
          "type": "note",
          "title": "Before a noun",
          "text": "Enough chairs, enough rice: before a noun, enough is a quantifier (1-4-11)."
        }
      ],
      "key_takeaway": "Old enough, not enough old.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "So for Strong Feeling",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "So makes an adjective or adverb stronger and shows feeling. It is common after be."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "The sunset was so beautiful!",
              "highlight": [
                "so"
              ],
              "explanation": "So shows how strongly the speaker feels."
            }
          ]
        },
        {
          "block_id": "BLOCK012",
          "type": "note",
          "title": "So or too?",
          "text": "So is just strong. Too means there is a problem."
        }
      ],
      "key_takeaway": "So adds feeling; too adds a problem.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 51,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
