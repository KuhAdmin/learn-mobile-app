      "title": "Degree Adverbs: Recap",
      "content": [
        {
          "block_id": "BLOCK013",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Degree adverbs answer \"how much?\".",
            "They go before the adjective or adverb.",
            "Very is a lot; too is a problem.",
            "Enough goes after: tall enough.",
            "So shows strong feeling."
          ]
        }
      ],
      "key_takeaway": "Choose the strength, then the place.",
