  "lesson": {
    "lesson_title": "Adverbs of Degree",
    "lesson_summary": "Adverbs of degree answer \"how much?\" or \"to what degree?\". Learners order them from a little to completely, place them before an adjective or another adverb, tell too (a problem) from very (a lot), and put enough after the adjective. Intensifiers and downtoners in depth are left to Stage 5.3 and comparison to Stage 5.2.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise and order degree adverbs.",
        "success_criteria": [
          "Order slightly, fairly, very and extremely.",
          "Find what a degree adverb describes."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Choose between too and very.",
        "success_criteria": [
          "Use too for a problem and very for a lot."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use enough and so.",
        "success_criteria": [
          "Put enough after an adjective.",
          "Use so for strong feeling."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
