      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Animals Can Get Things Too",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "Leela threw the parrot a green chilli.",
              "highlight": [
                "the parrot",
                "a green chilli"
              ],
              "explanation": "The parrot gets the chilli, so it is the indirect object."
            }
          ]
        }
      ],
      "key_takeaway": "The indirect object can be an animal.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 29,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Person First, Then Thing",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "When there are two objects, the indirect object comes first.",
          "scope": "Order",
          "examples": [
            {
              "sentence": "Dad bought my brother a cricket bat.",
              "highlight": [
                "my brother",
                "a cricket bat"
              ],
              "explanation": "The person comes before the thing."
            }
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "note",
          "title": "Not this",
          "text": "Dad bought a cricket bat my brother."
        }
      ],
      "key_takeaway": "Indirect object before direct object.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 46,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Never an Indirect Object Alone",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "An indirect object needs a direct object with it. You can give a book, or give someone a book, but you can't just give someone.",
          "scope": "Completeness",
          "examples": [
            {
              "sentence": "I gave her my old bicycle.",
              "highlight": [
                "her",
                "my old bicycle"
              ],
              "explanation": "Without my old bicycle, \"I gave her.\" is incomplete."
            }
          ]
        }
      ],
      "key_takeaway": "Give someone something, not just give someone.",
