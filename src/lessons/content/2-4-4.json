      "title": "Two Objects After One Verb",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Some verbs take two objects: a thing, and the person who gets it. You met the indirect object in 1-2-13."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Nani posted my cousin a birthday card.",
              "highlight": [
                "my cousin",
                "a birthday card"
              ],
              "explanation": "My cousin gets something; a birthday card is the thing posted."
            }
          ]
        }
      ],
      "key_takeaway": "A thing, and someone who gets it.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 50,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Thing and the Person",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "The direct object is the thing given, sent or made. The indirect object is the person who gets it.",
          "scope": "Two objects",
          "examples": [
            {
              "sentence": "The waiter brought us the menu.",
              "highlight": [
                "us",
                "the menu"
              ],
              "explanation": "Us is the indirect object; the menu is the direct object."
            }
          ]
        }
      ],
      "key_takeaway": "Direct: the thing. Indirect: who gets it.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
