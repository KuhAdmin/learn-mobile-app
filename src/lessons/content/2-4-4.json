  "lesson": {
    "lesson_title": "Direct and Indirect Objects",
    "lesson_summary": "Some verbs take two objects. The indirect object (met in 1-2-13) is the person or animal who gets something; the direct object is the thing. Learners tell them apart, put the indirect object first, check that an indirect object always has a direct object with it, and learn the common two-object verbs. Rewriting with to or for is left to 2-4-12.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Tell the direct object from the indirect object.",
        "success_criteria": [
          "Find the thing and the person who gets it."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Put two objects in the right order.",
        "success_criteria": [
          "Put the person before the thing.",
          "Keep a direct object with an indirect one."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Recognise verbs that take two objects.",
        "success_criteria": [
          "Name common two-object verbs."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
