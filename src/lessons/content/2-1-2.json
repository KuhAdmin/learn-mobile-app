  "lesson": {
    "lesson_title": "Main Verbs and Helping Verbs",
    "lesson_summary": "Learners tell the main verb, which carries the meaning, from helping verbs (forms of be, have and do, and words such as can and will) that come before it. They see the helping verb move to the front in questions, and notice that be, have and do can also be main verbs. Each auxiliary is taught in depth in Stage 3.2, and modal verbs in Stage 3.3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Tell main verbs from helping verbs.",
        "success_criteria": [
          "Find the main verb in a verb phrase.",
          "Name common helping verbs."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Spot the helping verb in a question.",
        "success_criteria": [
          "Find the helper before the subject."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Recognise be, have and do as main verbs.",
        "success_criteria": [
          "Tell 'has finished' from 'has a pet'."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 6
  },
