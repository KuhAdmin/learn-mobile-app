  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "A Verb With a Helper",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Many verbs come in a team: a helping verb first, then the main verb that carries the meaning."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "We have painted the garden fence.",
              "highlight": [
                "have",
                "painted"
              ],
              "explanation": "Have helps; painted tells us the action."
            }
          ]
        }
      ],
      "key_takeaway": "Helping verbs team up with main verbs.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Main Verb Carries the Meaning",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "The main verb tells the action or state. In a verb phrase, it comes last, after any helping verbs.",
          "scope": "Verb phrases with helping verbs",
          "examples": [
            {
              "sentence": "The chef is chopping onions.",
              "highlight": [
                "chopping"
              ],
              "explanation": "Chopping is the action, so it is the main verb; is only helps."
            },
            {
              "sentence": "My cousins will arrive tomorrow.",
              "highlight": [
                "arrive"
              ],
              "explanation": "Arrive carries the meaning; will helps to point to the future."
            }
          ]
        }
      ],
      "key_takeaway": "The last verb in the team carries the meaning.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Common Helping Verbs",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Forms of be: am, is, are, was, were",
            "Forms of have: has, have, had",
            "Forms of do: do, does, did",
            "Others: can, will, must, should"
          ]
        }
      ],
      "key_takeaway": "Be, have, do and can are common helpers.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Helpers Jump to the Front",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "In a question, the helping verb usually moves to the front, before the subject. The main verb stays behind."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Does your brother like mangoes?",
              "highlight": [
                "Does",
                "like"
              ],
              "explanation": "Does is the helper at the front; like is the main verb."
            }
          ]
        }
      ],
      "key_takeaway": "In questions, the helper comes first.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Helper or Main Verb?",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "comparison",
          "items": [
            {
              "label": "Helping verb",
              "description": "Another verb carries the meaning.",
              "example": "Riya has finished her homework."
            },
            {
              "label": "Main verb",
              "description": "It carries the meaning itself.",
              "example": "Riya has a pet tortoise."
            }
          ],
          "comparison_points": [
            "In the first sentence, finished is the main verb and has only helps.",
            "In the second, no other verb follows, so has means owns."
          ],
          "conclusion": "Be, have and do are helpers only when another verb follows."
        }
      ],
      "key_takeaway": "No other verb after it? Then it is the main verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
