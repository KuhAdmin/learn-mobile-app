      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Main and Helping Verbs: Recap",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "The main verb carries the meaning and comes last.",
            "Helping verbs: be, have, do, can, will, must.",
            "In questions, the helper moves to the front.",
            "Be, have and do can also be main verbs."
          ]
        }
      ],
      "key_takeaway": "Find the main verb, then its helpers.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 30,
