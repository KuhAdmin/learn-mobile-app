  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "All of Them, or Just These?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Sometimes we talk about a whole kind of thing. Sometimes we mean particular ones. The article shows which."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Bees make honey, but the bees in our garden seem lazy.",
              "highlight": [
                "Bees",
                "the bees"
              ],
              "explanation": "Bees means all bees. The bees in our garden means particular ones."
            }
          ]
        }
      ],
      "key_takeaway": "The article shows general or particular.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Talking About a Whole Kind",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "To talk about a whole kind of thing, use a plural or uncountable noun with no article.",
          "scope": "General statements",
          "examples": [
            {
              "sentence": "Owls hunt at night.",
              "highlight": [
                "Owls"
              ],
              "explanation": "This is true of owls in general, so there is no article."
            }
          ]
        }
      ],
      "key_takeaway": "A whole kind: no article.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Talking About Particular Ones",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "Add the when you mean particular ones that the listener can pick out."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "The owls in the old temple hoot all night.",
              "highlight": [
                "The owls"
              ],
              "explanation": "Only the owls in that temple, so we use the."
            }
          ]
        }
      ],
      "key_takeaway": "Particular ones: the.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Rice or The Rice?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "General",
              "description": "Rice of any kind, anywhere.",
              "example": "Rice grows well in wet fields."
            },
            {
              "label": "Particular",
              "description": "Rice we can point to.",
              "example": "The rice on my plate is burnt."
            }
          ],
          "comparison_points": [
            "In the first sentence, we mean all rice.",
            "In the second, we mean only the rice on one plate."
          ],
          "conclusion": "Ask: do I mean all of it, or this particular one?"
        }
      ],
      "key_takeaway": "Ask: all of them, or these ones?",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A for Any One Member",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "A with a singular noun can also mean any member of a kind. What is true of one is true of all."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "A koala sleeps most of the day.",
              "highlight": [
                "A koala"
              ],
              "explanation": "This means any koala at all, so it describes koalas in general."
            }
          ]
        }
      ],
      "key_takeaway": "A koala can mean any koala.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
