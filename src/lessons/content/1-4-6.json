        "OBJ002"
      ],
      "title": "General or Specific: Recap",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "A whole kind: plural or uncountable, no article.",
            "Particular ones: the.",
            "Any one member: a + singular noun.",
            "Ask: all of them, or these ones?"
          ]
        }
      ],
      "key_takeaway": "Choose the article by what you mean.",
