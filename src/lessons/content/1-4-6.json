  "lesson": {
    "lesson_title": "General and Specific Reference",
    "lesson_summary": "Learners choose articles by meaning: no article with plural and uncountable nouns to talk about a whole kind of thing, the to talk about particular ones the listener can pick out, and a with a singular noun to mean any one member of a kind. The separate rules for each article were taught in 1-4-2 to 1-4-5; this lesson puts them side by side.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Tell general reference from specific reference.",
        "success_criteria": [
          "Use no article for a whole kind of thing.",
          "Use the for particular ones."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use a for any member of a kind.",
        "success_criteria": [
          "Explain 'A koala sleeps most of the day.'"
        ]
      }
    ],
    "estimated_duration_minutes": 10,
    "total_pages": 6
  },
