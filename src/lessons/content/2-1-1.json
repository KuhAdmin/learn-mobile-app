  "lesson": {
    "lesson_title": "Introduction to Verbs",
    "lesson_summary": "Learners already know that a verb shows an action or a state (1.1.2). This lesson shows that every sentence needs a verb, gives two ways to find it (ask what the subject does or is; change the time and see which word changes), shows that a verb can be more than one word, and previews the kinds of verbs in this chapter.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Explain that every sentence needs a verb.",
        "success_criteria": [
          "Tell a sentence from a group of words with no verb."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Find the verb in a sentence.",
        "success_criteria": [
          "Ask what the subject does or is.",
          "Find a verb of two words."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Name the main kinds of verbs.",
        "success_criteria": [
          "Match a verb with its kind."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
