  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Engine of a Sentence",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "The verb is the engine of a sentence. It tells us what happens, or what is true."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The ferry leaves at noon.",
              "highlight": [
                "leaves"
              ],
              "explanation": "Leaves tells us what the ferry does."
            }
          ]
        }
      ],
      "key_takeaway": "The verb drives the sentence.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "No Verb, No Sentence",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "comparison",
          "items": [
            {
              "label": "Missing a verb",
              "description": "We can't tell what happened.",
              "example": "The kites over the beach."
            },
            {
              "label": "With a verb",
              "description": "Now the words make a sentence.",
              "example": "The kites soared over the beach."
            }
          ],
          "comparison_points": [
            "In the first group of words, nothing happens.",
            "In the second, soared tells us what the kites did."
          ],
          "conclusion": "Every complete sentence needs at least one verb."
        }
      ],
      "key_takeaway": "No verb, no sentence.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "How to Find the Verb",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Ask what the subject does or is. Or say the sentence about yesterday: the word that changes is the verb.",
          "scope": "Sentences with one verb",
          "examples": [
            {
              "sentence": "Grandma knits scarves every winter.",
              "highlight": [
                "knits"
              ],
              "explanation": "Grandma knits; about yesterday it becomes knitted."
            },
            {
              "sentence": "Our neighbour is a firefighter.",
              "highlight": [
                "is"
              ],
              "explanation": "Is tells us what our neighbour is; about the past it becomes was."
            }
          ]
        }
      ],
      "key_takeaway": "The verb is the word that changes with time.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Verbs With More Than One Word",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "Sometimes the verb is two or three words: a helping verb and a main verb together."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "The baby is giggling at the puppy.",
              "highlight": [
                "is giggling"
              ],
              "explanation": "Is and giggling work together as one verb."
            }
          ]
        }
      ],
      "key_takeaway": "A verb can be more than one word.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "The Verb Family",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "list",
          "introduction": "This chapter meets each kind in turn:",
          "list_style": "bulleted",
          "items": [
            "Main and helping: has finished",
            "Action and state: jump, know",
            "Linking: seem, become",
            "With or without an object: buy a kite, arrive",
            "Regular and irregular: walked, swam",
            "Finite and non-finite: walks, to walk",
            "Patterns: enjoy reading, want to go",
            "Phrasal: give up, look after"
          ]
        }
      ],
      "key_takeaway": "Verbs come in several kinds.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Verbs: Recap",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Every sentence needs a verb.",
            "Ask what the subject does or is.",
            "The verb changes when the time changes.",
            "A verb can be more than one word.",
            "There are several kinds, each with its own lesson."
          ]
        }
      ],
      "key_takeaway": "Find the verb first, then the rest makes sense.",
      "page_audit": {
        "primary_objective_count": 3,
