      "type": "multiple_choice",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "prompt": "Which group of words is a full sentence?",
      "options": [
        {
          "option_id": "A",
          "text": "The tiger prowled through the grass."
        },
        {
          "option_id": "B",
          "text": "The tiger through the tall grass."
        },
        {
          "option_id": "C",
          "text": "Through the tall grass at night."
        }
      ],
      "correct_answers": [
        "A"
      ],
      "explanation": "Only the first has a verb, prowled, so only it is a sentence."
    },
