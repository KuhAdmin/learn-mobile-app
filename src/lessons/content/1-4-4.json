      ],
      "title": "Pointing to a Particular One",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "The points to a particular person or thing that the listener can pick out."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Can you water the money plant on the balcony?",
              "highlight": [
                "the money plant"
              ],
              "explanation": "There is one particular money plant, and the listener knows which."
            }
          ]
        }
      ],
      "key_takeaway": "The means a particular one.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
