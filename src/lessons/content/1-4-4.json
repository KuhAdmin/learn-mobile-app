      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "The Works With Every Noun",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "text",
          "text": "Unlike a, the works with singular, plural and uncountable nouns."
        },
        {
          "block_id": "BLOCK012",
          "type": "example",
          "examples": [
            {
              "sentence": "The biscuits in this tin are stale.",
              "highlight": [
                "The biscuits"
              ],
              "explanation": "Biscuits is plural, and the still works."
            },
            {
              "sentence": "The water in the well is icy.",
              "highlight": [
                "The water"
              ],
              "explanation": "Water is uncountable, and the still works."
            }
          ]
        }
      ],
      "key_takeaway": "The fits singular, plural and uncountable nouns.",
