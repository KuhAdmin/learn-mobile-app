  "lesson": {
    "lesson_title": "Definite Article – The",
    "lesson_summary": "Learners use the for a particular person or thing the listener can pick out: something mentioned before, something both speakers know, something there is only one of, or something picked out by a phrase after the noun. They see that the works with singular, plural and uncountable nouns. The with names of rivers, seas and some countries is left to 1-4-8.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use the for second mentions and shared knowledge.",
        "success_criteria": [
          "Change a to the on a second mention.",
          "Use the for something both speakers know."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use the for unique things and things picked out by a phrase.",
        "success_criteria": [
          "Say the sun and the sky.",
          "Say the bag on the chair."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use the with any kind of noun.",
        "success_criteria": [
          "Use the with singular, plural and uncountable nouns."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
