          "type": "example",
          "examples": [
            {
              "sentence": "After school, my brother made me a sandwich.",
              "highlight": [
                "my brother made me a sandwich"
              ],
              "explanation": "Cross out after school. Two objects are left: me and a sandwich, so the pattern is SVOO."
            }
          ]
        }
      ],
      "key_takeaway": "Work through the steps in order.",
