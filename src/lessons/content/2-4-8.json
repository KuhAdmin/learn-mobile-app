      "title": "Same Pattern, More Detail",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Every evening, Grandpa reads the newspaper on the porch.",
              "highlight": [
                "Grandpa reads the newspaper"
              ],
              "explanation": "Every evening and on the porch are extras; the pattern is SVO."
            }
          ]
        }
      ],
      "key_takeaway": "Strip the extras to see the pattern.",
