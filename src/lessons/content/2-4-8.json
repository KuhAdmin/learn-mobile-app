      "title": "Find the Pattern in Four Steps",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "list",
          "introduction": "To find a sentence's pattern:",
          "list_style": "bulleted",
          "items": [
            "Find the verb.",
            "Find the subject.",
            "Cross out the adverbials.",
            "Look at what is left after the verb."
          ]
        }
      ],
      "key_takeaway": "Verb, subject, remove extras, look after the verb.",
      "page_audit": {
