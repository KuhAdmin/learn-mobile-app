      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Adverbials Are Extras",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "Adverbials add how, where or when. They make the sentence longer but don't change its pattern.",
          "scope": "Adverbials",
          "examples": [
            {
              "sentence": "The baby giggled happily in her pram.",
              "highlight": [
                "happily in her pram"
              ],
              "explanation": "Take away the adverbials and it is still SV."
            }
          ]
        }
      ],
      "key_takeaway": "How, where and when don't change the pattern.",
      "page_audit": {
        "primary_objective_count": 1,
