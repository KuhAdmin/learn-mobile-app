  "lesson": {
    "lesson_title": "Basic Sentence Patterns",
    "lesson_summary": "Most English sentences follow one of five patterns: SV, SVO, SVC, SVOO and SVOC. Learners see one example of each, learn that the verb decides the pattern, that adverbials are extras that don't change it, and find a sentence's pattern in four steps. Each pattern is taught in depth in 2-4-9 to 2-4-13.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Name the five sentence patterns.",
        "success_criteria": [
          "Match a sentence to SV, SVO, SVC, SVOO or SVOC."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "See that adverbials don't change the pattern.",
        "success_criteria": [
          "Find the pattern of a sentence with adverbials."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Find a sentence's pattern step by step.",
        "success_criteria": [
          "Use the four steps."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
