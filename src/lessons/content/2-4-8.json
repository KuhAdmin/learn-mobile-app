      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Verb Decides",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Each verb needs certain parts after it. Find the verb, then ask what it needs to be complete.",
          "scope": "Choosing the pattern",
          "examples": [
            {
              "sentence": "Rahul seems nervous.",
              "highlight": [
                "seems"
              ],
              "explanation": "Seems is a linking verb, so it needs a complement: SVC."
            }
          ]
        }
      ],
      "key_takeaway": "Find the verb, then ask what it needs.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
