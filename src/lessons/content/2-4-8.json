      ],
      "title": "Five Ways to Build a Sentence",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Most English sentences follow one of five patterns, built from subject (S), verb (V), object (O) and complement (C)."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The pressure cooker hissed.",
              "highlight": [
                "The pressure cooker hissed"
              ],
              "explanation": "Just a subject and a verb: the SV pattern."
            }
          ]
        }
      ],
      "key_takeaway": "Five patterns cover most sentences.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 46,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Five Patterns",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "SV: The baby giggled.",
            "SVO: The baby dropped her rattle.",
            "SVC: The baby is hungry.",
            "SVOO: Mum gave the baby a bath.",
            "SVOC: The lullaby made the baby sleepy."
          ]
        }
      ],
      "key_takeaway": "SV, SVO, SVC, SVOO, SVOC.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 31,
        "density_status": "passed",
        "standalone_understanding": "passed"
