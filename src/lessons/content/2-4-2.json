  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Two Halves of a Sentence",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Every sentence has two halves. The subject says who or what the sentence is about. The predicate says what the subject does or is."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The old fisherman mended his net.",
              "highlight": [
                "The old fisherman",
                "mended his net"
              ],
              "explanation": "The old fisherman is the subject; mended his net is the predicate."
            }
          ]
        }
      ],
      "key_takeaway": "Who it is about, and what is said about it.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 56,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Predicate Starts With the Verb",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "The predicate begins with the verb and includes everything after it.",
          "scope": "Splitting a sentence",
          "examples": [
            {
              "sentence": "My little brother collects shiny stones.",
              "highlight": [
                "collects shiny stones"
              ],
              "explanation": "The predicate starts at the verb collects."
            }
          ]
        }
      ],
      "key_takeaway": "Find the verb, then cut.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Long Subjects, Long Predicates",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "The boy in the blue jacket laughed.",
              "highlight": [
                "The boy in the blue jacket"
              ],
              "explanation": "A long subject, and a one-word predicate."
            },
            {
              "sentence": "Parrots chatter all day in the guava tree.",
              "highlight": [
                "chatter all day in the guava tree"
              ],
              "explanation": "A one-word subject, and a long predicate."
            }
          ]
        }
      ],
      "key_takeaway": "Either half can be long.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Simple and Complete Subject",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "The complete subject is the main noun with all its describing words. The simple subject is the main noun alone."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "The tall, smiling teacher waved.",
              "highlight": [
                "teacher"
              ],
              "explanation": "The complete subject is \"The tall, smiling teacher\". The simple subject is teacher."
            }
          ]
        }
      ],
      "key_takeaway": "The main noun is the simple subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Simple and Complete Predicate",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "The complete predicate is the verb with everything after it. The simple predicate is the verb alone."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "The puppy chewed my new slipper.",
              "highlight": [
                "chewed"
              ],
              "explanation": "The complete predicate is \"chewed my new slipper\". The simple predicate is chewed."
            }
          ]
        }
      ],
      "key_takeaway": "The verb is the simple predicate.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Commands Hide You",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "rule",
          "rule_id": "RULE009",
          "rule_text": "In a command, the subject you is not said, but it is understood.",
          "scope": "Commands",
          "examples": [
            {
              "sentence": "Please shut the gate.",
              "highlight": [
                "shut the gate"
              ],
              "explanation": "Who should shut it? You. The whole sentence is the predicate."
            }
          ]
        }
      ],
      "key_takeaway": "In a command, the subject is you.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "When the Subject Isn't First",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "A sentence can start with an adverbial. Then the subject comes after it."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "After lunch, the whole class played kabaddi.",
              "highlight": [
                "the whole class"
              ],
              "explanation": "After lunch is an opener; the subject is the whole class."
            }
          ]
        }
      ],
      "key_takeaway": "Skip the opener to find the subject.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 43,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Subject and Predicate: Recap",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Subject: who or what it is about.",
            "Predicate: the verb and everything after.",
            "Simple subject: the main noun. Simple predicate: the verb.",
            "Commands: the subject you is understood.",
            "Skip an opener to find the subject."
          ]
        }
      ],
      "key_takeaway": "Find the verb, then split.",
