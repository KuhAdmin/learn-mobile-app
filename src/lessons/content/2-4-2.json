  "lesson": {
    "lesson_title": "Subject and Predicate",
    "lesson_summary": "Every sentence has two halves: the subject (who or what it is about) and the predicate (the verb and everything after it). Learners split sentences in two, tell the simple subject and predicate from the complete ones, and find the subject when it is hidden (commands) or comes after an opening phrase. Agreement was taught in Stage 2.3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Split a sentence into subject and predicate.",
        "success_criteria": [
          "Find where the predicate starts."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Tell simple from complete subjects and predicates.",
        "success_criteria": [
          "Find the main noun of the subject.",
          "Find the verb of the predicate."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Find hidden and late subjects.",
        "success_criteria": [
          "Name the subject of a command.",
          "Find the subject after an opening phrase."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
