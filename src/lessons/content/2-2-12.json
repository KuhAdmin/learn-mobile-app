  "lesson": {
    "lesson_title": "Focusing Adverbs",
    "lesson_summary": "Focusing adverbs point to one part of a sentence: only, just, even, also, too, as well, especially and mainly. Learners use even and especially, see how moving only changes the meaning, and place also before the main verb and too or as well at the end. Focus and limiting modifiers in depth are left to Stage 5.3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise focusing adverbs.",
        "success_criteria": [
          "Say what even and especially add.",
          "Find the focusing adverb in a sentence."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Place only next to the part it focuses on.",
        "success_criteria": [
          "Explain how moving only changes the meaning."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use also, too and as well.",
        "success_criteria": [
          "Put also before the main verb.",
          "Put too and as well at the end."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
