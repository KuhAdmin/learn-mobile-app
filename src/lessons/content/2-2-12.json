        "OBJ003"
      ],
      "title": "Pointing to One Part",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Focusing adverbs point to one part of a sentence and make it stand out."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Even the teacher laughed at the joke.",
              "highlight": [
                "Even the teacher"
              ],
              "explanation": "Even shows that the teacher laughing is a surprise."
            }
          ]
        }
      ],
      "key_takeaway": "Focusing adverbs make one part stand out.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 41,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Common Focusing Adverbs",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "only, just – nothing or nobody else",
            "even – this is surprising",
            "also, too, as well – in addition",
            "especially, particularly – more than the others",
            "mainly, mostly – for the biggest part"
          ]
        }
      ],
      "key_takeaway": "Each focus word adds its own meaning.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Even and Especially",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "My grandmother even uses a smartphone.",
              "highlight": [
                "even uses"
              ],
              "explanation": "Even shows the speaker finds this surprising."
            },
            {
              "sentence": "I love fruit, especially mangoes.",
              "highlight": [
                "especially mangoes"
              ],
              "explanation": "Especially picks out mangoes from all fruit."
            }
          ]
        }
      ],
      "key_takeaway": "Even surprises; especially singles out.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 34,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Moving Only",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "comparison",
          "items": [
            {
              "label": "Before the person",
              "description": "Nobody else did it.",
              "example": "Only Mina ate the cake."
            },
            {
              "label": "Before the thing",
              "description": "She ate nothing else.",
              "example": "Mina ate only the cake."
            }
          ],
          "comparison_points": [
            "In the first sentence, Mina is the one person who ate the cake.",
            "In the second, the cake is the one thing Mina ate."
          ],
          "conclusion": "Put only right before the part you want to focus on."
        }
      ],
      "key_takeaway": "Move only and the meaning moves too.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 62,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Only Next to Its Part",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "Put only just before the word or phrase it focuses on.",
          "scope": "Placing only",
          "examples": [
            {
              "sentence": "We have only ten minutes left.",
              "highlight": [
                "only ten minutes"
              ],
              "explanation": "Only limits ten minutes: no more time than that."
            }
          ]
        }
      ],
      "key_takeaway": "Keep only beside the words it limits.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Also Before the Main Verb",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "Also goes before the main verb, or after be.",
          "scope": "Middle position",
          "examples": [
            {
              "sentence": "Priya also plays the tabla.",
              "highlight": [
                "also plays"
              ],
              "explanation": "Also comes just before the main verb plays."
            }
          ]
        },
        {
          "block_id": "BLOCK008",
          "type": "note",
          "title": "After be",
          "text": "She is also in the school band."
        }
      ],
      "key_takeaway": "Also goes where always goes.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Too and As Well at the End",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "rule",
          "rule_id": "RULE009",
          "rule_text": "Too and as well mean the same as also, but they go at the end.",
          "scope": "End position",
          "examples": [
            {
              "sentence": "Karan sings in the choir too.",
              "highlight": [
                "too"
              ],
              "explanation": "Too comes at the end of the sentence."
            },
            {
              "sentence": "His sister sings in the choir as well.",
              "highlight": [
                "as well"
              ],
              "explanation": "As well also comes at the end."
            }
          ]
        }
      ],
      "key_takeaway": "Too and as well come last.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 59,
