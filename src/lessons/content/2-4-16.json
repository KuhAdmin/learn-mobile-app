  "lesson": {
    "lesson_title": "Word Order in Questions",
    "lesson_summary": "In most questions, a helper comes before the subject. Learners build yes / no questions (helper + subject + verb), add do, does or did when there is no helper (with the base form after it), build wh- questions (question word + helper + subject + verb), and ask about the subject with no do (Who ate the last samosa?). Question words were taught in 2-2-10 and 1-3-8.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Build yes / no questions.",
        "success_criteria": [
          "Put the helper first.",
          "Add do, does or did when there is no helper."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Build wh- questions.",
        "success_criteria": [
          "Put the question word, then the helper."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Ask about the subject.",
        "success_criteria": [
          "Use no do when who or what is the subject."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
