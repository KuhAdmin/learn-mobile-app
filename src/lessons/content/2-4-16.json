  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Building a Question",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "In most questions, a helper comes before the subject."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Can your sister ride a bicycle?",
              "highlight": [
                "Can your sister ride"
              ],
              "explanation": "The helper can comes before the subject your sister."
            }
          ]
        }
      ],
      "key_takeaway": "In most questions, the helper comes first.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Helper, Subject, Verb",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "For a yes / no question, put the first helper (or be) before the subject.",
          "scope": "Yes / no questions",
          "examples": [
            {
              "sentence": "Is the library open on Sundays?",
              "highlight": [
                "Is the library"
              ],
              "explanation": "Is moves before the library."
            },
            {
              "sentence": "Have the guests arrived?",
              "highlight": [
                "Have the guests arrived"
              ],
              "explanation": "Have moves before the guests."
            }
          ]
        }
      ],
      "key_takeaway": "Move the helper to the front.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 50,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "No Helper? Use Do, Does or Did",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "If the statement has no helper, add do, does or did before the subject. The main verb goes back to its base form.",
          "scope": "do-questions",
          "examples": [
            {
              "sentence": "Does your cat like fish?",
              "highlight": [
                "Does your cat like"
              ],
              "explanation": "Does carries the -s, so like has none."
            },
            {
              "sentence": "Did you finish the puzzle?",
              "highlight": [
                "Did you finish"
              ],
              "explanation": "Did shows the past, so finish stays in its base form."
            }
          ]
        }
      ],
      "key_takeaway": "Do, does, did + base form.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 70,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Question Word First",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "A wh- question starts with the question word, then the helper, then the subject and verb.",
          "scope": "Wh- questions",
          "examples": [
            {
              "sentence": "Where are you taking the puppy?",
              "highlight": [
                "Where are you taking"
              ],
              "explanation": "Where, then the helper are, then you."
            },
            {
              "sentence": "When does the next ferry leave?",
              "highlight": [
                "When does the next ferry leave"
              ],
              "explanation": "When, then does, then the subject."
            }
          ]
        }
      ],
      "key_takeaway": "Question word, helper, subject, verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 59,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "common_mistake",
      "pedagogical_role": "error_analysis",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Don't Forget the Helper",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "Where you bought this kite?",
            "correct": "Where did you buy this kite?",
            "reason": "A wh- question needs a helper before the subject; with no other helper, use did and the base form."
          },
          "related_learning_objective_ids": [
            "OBJ002"
          ]
        }
      ],
      "key_takeaway": "Wh- questions need a helper too.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Asking About the Subject",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "When who or what is the subject of the question, keep statement order and use no do.",
          "scope": "Subject questions",
          "examples": [
            {
              "sentence": "Who ate the last samosa?",
              "highlight": [
                "Who ate"
              ],
              "explanation": "Who is the subject, so there is no did."
            }
          ]
        }
      ],
      "key_takeaway": "Who or what is the subject? No do.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Who Called? Or Who Did You Call?",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "comparison",
          "items": [
            {
              "label": "Asking about the subject",
              "description": "No do.",
              "example": "Who called Grandma?"
            },
            {
              "label": "Asking about the object",
              "description": "Use do, does or did.",
              "example": "Who did Grandma call?"
            }
          ],
          "comparison_points": [
            "In the first question, someone called Grandma.",
            "In the second, Grandma called someone."
          ],
          "conclusion": "Ask whether who is doing the action or receiving it."
        }
      ],
      "key_takeaway": "Subject question: no do. Object question: do.",
