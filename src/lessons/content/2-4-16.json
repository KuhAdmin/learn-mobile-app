      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Question Order: Recap",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Yes / no: helper + subject + verb.",
            "No helper: do, does, did + base form.",
            "Wh-: question word + helper + subject + verb.",
            "Who or what as subject: no do."
          ]
        }
      ],
      "key_takeaway": "Helper first, unless who is the subject.",
