  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ004"
      ],
      "title": "Spelling More Than One",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Most nouns just add -s. But box becomes boxes, baby becomes babies and mouse becomes mice. This lesson shows the rules and the special cases."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The babies played with the empty boxes.",
              "highlight": [
                "babies",
                "boxes"
              ],
              "explanation": "Baby and box change their spelling in different ways when they become plural."
            }
          ]
        }
      ],
      "key_takeaway": "Plural spelling follows rules, with a few exceptions.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Add -s to Most Nouns",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "To make most nouns plural, add -s.",
          "scope": "Regular English nouns",
          "examples": [
            {
              "sentence": "We flew two kites at the beach.",
              "highlight": [
                "kites"
              ],
              "explanation": "Kite + s = kites."
            },
            {
              "sentence": "Our school has four gates.",
              "highlight": [
                "gates"
              ],
              "explanation": "Gate + s = gates."
            }
          ]
        }
      ],
      "key_takeaway": "Most nouns just add -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Add -es After s, x, z, ch and sh",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "If a noun ends in s, x, z, ch or sh, add -es. This adds an extra sound you can hear: box, boxes.",
          "scope": "Regular English nouns",
          "conditions": [
            "The noun ends in s, x, z, ch or sh."
          ],
          "examples": [
            {
              "sentence": "Dad washed the dinner dishes.",
              "highlight": [
                "dishes"
              ],
              "explanation": "Dish ends in sh, so we add -es."
            },
            {
              "sentence": "The foxes hid in the bushes.",
              "highlight": [
                "foxes",
                "bushes"
              ],
              "explanation": "Fox ends in x and bush ends in sh, so both add -es."
            }
          ]
        }
      ],
      "key_takeaway": "After s, x, z, ch or sh, add -es.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Nouns Ending in y",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "If a consonant comes before y, change y to i and add -es. If a vowel comes before y, just add -s.",
          "scope": "Common nouns ending in y (names such as the Kumars follow other rules)",
          "conditions": [
            "Consonant + y: puppy, city, lady.",
            "Vowel + y: key, toy, monkey."
          ],
          "examples": [
            {
              "sentence": "Two puppies chased the ball.",
              "highlight": [
                "puppies"
              ],
              "explanation": "P comes before y, so puppy becomes puppies."
            },
            {
              "sentence": "The monkeys stole our bananas.",
              "highlight": [
                "monkeys"
              ],
              "explanation": "E comes before y, so monkey just adds -s."
            }
          ]
        }
      ],
      "key_takeaway": "Consonant + y becomes -ies; vowel + y adds -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 55,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Nouns Ending in f or fe",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Many nouns ending in f or fe change to -ves: leaf, leaves; knife, knives.",
          "scope": "Many, but not all, nouns ending in f or fe",
          "examples": [
            {
              "sentence": "Autumn leaves covered the path.",
              "highlight": [
                "leaves"
              ],
              "explanation": "Leaf changes f to v and adds -es."
            },
            {
              "sentence": "Put the knives back in the drawer.",
              "highlight": [
                "knives"
              ],
              "explanation": "Knife changes fe to -ves."
            }
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "Exceptions",
          "text": "Some just add -s: roofs, chiefs, cliffs."
        }
      ],
      "key_takeaway": "Many f and fe nouns change to -ves.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Nouns Ending in o",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "Some nouns ending in o add -es: tomatoes, potatoes, heroes. Others add -s: photos, pianos, kangaroos.",
          "scope": "Nouns ending in o; learn the common -es words",
          "examples": [
            {
              "sentence": "Grandma grew tomatoes and potatoes.",
              "highlight": [
                "tomatoes",
                "potatoes"
              ],
              "explanation": "Tomato and potato add -es."
            },
            {
              "sentence": "We took lots of photos at the zoo.",
              "highlight": [
                "photos"
              ],
              "explanation": "Photo just adds -s."
            }
          ]
        }
      ],
      "key_takeaway": "Some o nouns add -es; others add -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ004"
      ],
      "title": "Irregular: The Vowels Change",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "text",
          "text": "Some nouns don't add -s at all. Instead, the vowels inside the word change."
        },
        {
          "block_id": "BLOCK010",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "man → men",
            "woman → women",
            "foot → feet",
            "tooth → teeth",
            "mouse → mice",
            "goose → geese"
          ]
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "Two geese waddled across the farm.",
              "highlight": [
                "geese"
              ],
              "explanation": "Goose becomes geese. There is no -s."
            }
          ]
        }
      ],
      "key_takeaway": "Some plurals change the vowels inside the word.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ004"
      ],
      "title": "Irregular: Adding -en",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "text",
          "text": "A few very old nouns make their plural with -en: child becomes children and ox becomes oxen."
        },
        {
          "block_id": "BLOCK013",
          "type": "example",
          "examples": [
            {
              "sentence": "The oxen pulled the heavy cart.",
              "highlight": [
                "oxen"
              ],
              "explanation": "Ox + en = oxen."
            },
            {
              "sentence": "Six children waited for the ferry.",
              "highlight": [
                "children"
              ],
              "explanation": "Child + ren = children."
            }
          ]
        }
      ],
      "key_takeaway": "Child becomes children; ox becomes oxen.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE009",
      "page_number": 9,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ004"
      ],
      "title": "Irregular: No Change at All",
      "content": [
        {
          "block_id": "BLOCK014",
          "type": "text",
          "text": "Some nouns look the same for one and for more than one: sheep, deer, fish and aircraft."
        },
        {
          "block_id": "BLOCK015",
          "type": "example",
          "examples": [
            {
              "sentence": "We spotted three deer in the forest.",
              "highlight": [
                "deer"
              ],
              "explanation": "One deer, three deer. The word does not change."
            }
          ]
        }
      ],
      "key_takeaway": "Sheep, deer and fish don't change.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE010",
      "page_number": 10,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ005"
      ],
      "title": "Plurals of Compound Nouns",
      "content": [
        {
          "block_id": "BLOCK016",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "Make the main word of the compound plural. In brother-in-law and passer-by, the main word comes first.",
          "scope": "Hyphenated and open compound nouns",
          "examples": [
            {
              "sentence": "Both my sisters-in-law came to dinner.",
              "highlight": [
                "sisters-in-law"
              ],
              "explanation": "Sister is the main word, so it takes the -s."
            },
            {
              "sentence": "Two passers-by helped the old man.",
              "highlight": [
                "passers-by"
              ],
              "explanation": "Passer is the main word, so it takes the -s."
            }
          ]
        },
        {
          "block_id": "BLOCK017",
          "type": "note",
          "title": "Closed compounds",
          "text": "One-word compounds add the ending at the end: toothbrushes, classrooms."
        }
      ],
      "key_takeaway": "Make the main word plural.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 55,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE011",
      "page_number": 11,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003",
        "OBJ004",
        "OBJ005"
      ],
      "title": "Plural Spelling: Recap",
      "content": [
        {
          "block_id": "BLOCK018",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Most nouns add -s: kites.",
            "After s, x, z, ch or sh, add -es: dishes.",
            "Consonant + y becomes -ies: puppies. Vowel + y adds -s: monkeys.",
            "Many f/fe nouns become -ves: knives. Some o nouns add -es: tomatoes.",
            "Irregular plurals: men, children, sheep.",
            "Compounds: make the main word plural."
          ]
        }
      ],
      "key_takeaway": "Learn the rules, then remember the exceptions.",
      "page_audit": {
        "primary_objective_count": 5,
        "estimated_visible_word_count": 50,
