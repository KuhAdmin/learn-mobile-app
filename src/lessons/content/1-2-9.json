  "lesson": {
    "lesson_title": "Regular and Irregular Plurals",
    "lesson_summary": "Learners already know what singular and plural mean (1-2-8). This lesson teaches how to spell plurals: adding -s or -es, the rules for nouns ending in y, f, fe and o, irregular plurals that change their vowels, add -en or stay the same, and plurals of compound nouns.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Form regular plurals with -s and -es.",
        "success_criteria": [
          "Add -s to most nouns.",
          "Add -es after s, x, z, ch and sh."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Form plurals of nouns ending in y.",
        "success_criteria": [
          "Change consonant + y to -ies.",
          "Add -s after vowel + y."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Form plurals of nouns ending in f, fe and o.",
        "success_criteria": [
          "Change many f and fe endings to -ves.",
          "Recognise exceptions such as roofs.",
          "Choose -es or -s for nouns ending in o."
        ]
      },
      {
        "objective_id": "OBJ004",
        "description": "Recognise irregular plurals.",
        "success_criteria": [
          "Recognise vowel-change plurals such as feet.",
          "Recognise -en plurals such as children.",
          "Recognise nouns that stay the same, such as sheep."
        ]
      },
      {
        "objective_id": "OBJ005",
        "description": "Form plurals of compound nouns.",
        "success_criteria": [
          "Make the main word of a compound plural."
        ]
      }
    ],
    "estimated_duration_minutes": 16,
    "total_pages": 11
  },
