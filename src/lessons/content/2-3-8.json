  "lesson": {
    "lesson_title": "Agreement with Subjects Joined by Or and Nor",
    "lesson_summary": "When or (or nor) joins two subjects, only one does the action, so the verb does not simply become plural. Singular or singular takes a singular verb; plural or plural takes a plural verb; when they are mixed, the verb agrees with the nearer subject, and putting the plural one last sounds more natural. In questions, the helper agrees with the subject right after it. Either … or and neither … nor are left to 2-3-9.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose the verb when or joins two subjects of the same number.",
        "success_criteria": [
          "Use a singular verb for singular or singular.",
          "Use a plural verb for plural or plural."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Apply the nearer-subject rule.",
        "success_criteria": [
          "Make the verb agree with the nearer subject.",
          "Put the plural subject last."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Choose the helper in questions with or.",
        "success_criteria": [
          "Make the helper agree with the subject right after it."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
