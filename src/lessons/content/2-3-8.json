  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Subjects Joined by Or",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "When or joins two subjects, only one of them does the action. So the verb doesn't simply become plural, the way it does with and. Nor works the same way."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Tea or coffee is served after dinner.",
              "highlight": [
                "Tea or coffee is served"
              ],
              "explanation": "Only one drink is served, so the verb is singular."
            }
          ]
        }
      ],
      "key_takeaway": "Or picks one, so the verb doesn't just go plural.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 60,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Singular Or Singular",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "When or joins two singular subjects, the verb is singular.",
          "scope": "singular or singular",
          "examples": [
            {
              "sentence": "A pen or a pencil works for this test.",
              "highlight": [
                "works"
              ],
              "explanation": "Only one is used, so works has -s."
            }
          ]
        }
      ],
      "key_takeaway": "One or one: singular verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 37,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Plural Or Plural",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "When or joins two plural subjects, the verb is plural.",
          "scope": "plural or plural",
          "examples": [
            {
              "sentence": "Apples or bananas make a good snack.",
              "highlight": [
                "make"
              ],
              "explanation": "Both choices are plural, so make has no -s."
            }
          ]
        }
      ],
      "key_takeaway": "Many or many: plural verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 36,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "The Nearer Subject Decides",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "When one subject is singular and the other plural, the verb agrees with the subject nearer to it.",
          "scope": "Mixed subjects",
          "examples": [
            {
              "sentence": "My brother or my cousins are coming to pick me up.",
              "highlight": [
                "my cousins are"
              ],
              "explanation": "Cousins is nearer to the verb, so the verb is plural."
            },
            {
              "sentence": "My cousins or my brother is coming to pick me up.",
              "highlight": [
                "my brother is"
              ],
              "explanation": "Brother is nearer to the verb, so the verb is singular."
            }
          ]
        }
      ],
      "key_takeaway": "Mixed? Match the closer one.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 77,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Put the Plural Last",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "Both orders are correct, but a plural verb usually sounds better. Put the plural subject last.",
          "scope": "Choosing the order",
          "examples": [
            {
              "sentence": "A sandwich or some biscuits are fine for the trip.",
              "highlight": [
                "some biscuits are"
              ],
              "explanation": "The plural subject is last, so the verb is are."
            }
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "Nor",
          "text": "Nor usually comes after neither, which you will meet in 2-3-9."
        }
      ],
      "key_takeaway": "Plural last sounds natural.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 62,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Or in Questions",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "In a question, the helper comes first, so it agrees with the subject right after it. Put a plural subject there if one is plural.",
          "scope": "Questions with or",
          "examples": [
            {
              "sentence": "Are the twins or Asha joining us?",
              "highlight": [
                "Are the twins"
              ],
              "explanation": "Are agrees with the twins, the subject right after it."
            }
          ]
        }
      ],
      "key_takeaway": "The helper matches the subject after it.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 54,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Is or Are in a Question?",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "Is Grandpa or Grandma picking us up?",
              "highlight": [
                "Is Grandpa"
              ],
              "explanation": "Both subjects are singular, so the helper is is."
            },
            {
              "sentence": "Are your parents or your grandparents coming to the show?",
              "highlight": [
                "Are your parents"
              ],
              "explanation": "Both subjects are plural, so the helper is are."
            }
          ]
        }
      ],
      "key_takeaway": "Two singulars: is. A plural first: are.",
      "page_audit": {
        "primary_objective_count": 1,
