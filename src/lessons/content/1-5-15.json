  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Building Adjectives",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Add an ending to a noun or a verb and you can build an adjective: colour becomes colourful, home becomes homeless."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Colourful kites made the sky look cheerful.",
              "highlight": [
                "Colourful",
                "cheerful"
              ],
              "explanation": "Colour + ful and cheer + ful both make adjectives."
            }
          ]
        }
      ],
      "key_takeaway": "Endings can turn words into adjectives.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Full Of or Without?",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "comparison",
          "items": [
            {
              "label": "-ful",
              "description": "Full of something.",
              "example": "The puppy was playful all morning."
            },
            {
              "label": "-less",
              "description": "Without something.",
              "example": "The homeless kitten found a kind family."
            }
          ],
          "comparison_points": [
            "Playful means full of play.",
            "Homeless means without a home."
          ],
          "conclusion": "-ful adds; -less takes away."
        }
      ],
      "key_takeaway": "-ful means full of; -less means without.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "More Adjective Endings",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "-y: rain → rainy",
            "-ous: danger → dangerous",
            "-ive: act → active",
            "-able: wash → washable",
            "-al: nature → natural",
            "-ish: child → childish",
            "-ic: hero → heroic",
            "-en: wood → wooden, gold → golden"
          ]
        }
      ],
      "key_takeaway": "Many endings build adjectives.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "When the Spelling Changes",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Sometimes the base word changes: drop the final e (fame → famous), or double the last letter of a short word (sun → sunny).",
          "scope": "Adjectives built with suffixes",
          "examples": [
            {
              "sentence": "It was a sunny morning in Ooty.",
              "highlight": [
                "sunny"
              ],
              "explanation": "Sun doubles its n before -y."
            },
            {
              "sentence": "The young singer became famous overnight.",
              "highlight": [
                "famous"
              ],
              "explanation": "Fame drops its e before -ous."
            }
          ]
        }
      ],
      "key_takeaway": "Check the spelling when you add an ending.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Opposites With Un-, Im- and Dis-",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Add un-, in-, im- or dis- to the front of an adjective to make its opposite: unkind, incorrect, impossible, dishonest."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "It was unkind to laugh at his drawing.",
              "highlight": [
                "unkind"
              ],
              "explanation": "Un- + kind means not kind."
            },
            {
              "sentence": "Climbing that slippery wall is impossible.",
              "highlight": [
                "impossible"
              ],
              "explanation": "Im- + possible means not possible."
            }
          ]
        }
      ],
      "key_takeaway": "Un-, in-, im- and dis- make opposites.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
