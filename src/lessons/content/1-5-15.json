  "lesson": {
    "lesson_title": "Adjective Formation",
    "lesson_summary": "Learners build adjectives from nouns and verbs with suffixes: -ful and -less, -y, -ous, -ive, -able, -al, -ish, -ic and -en (wooden, woollen, golden). They notice spelling changes (fame → famous, sun → sunny) and make opposites with the prefixes un-, in-, im- and dis-. Noun formation was taught in 1-2-12; -ing and -ed adjectives in 1-5-11.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Form adjectives with suffixes.",
        "success_criteria": [
          "Use -ful and -less.",
          "Use -y, -ous, -ive, -able, -al, -ish, -ic and -en."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Spell adjectives when the base word changes.",
        "success_criteria": [
          "Write famous and sunny correctly."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Form opposites with prefixes.",
        "success_criteria": [
          "Use un-, in-, im- and dis-."
        ]
      }
    ],
    "estimated_duration_minutes": 13,
    "total_pages": 6
  },
