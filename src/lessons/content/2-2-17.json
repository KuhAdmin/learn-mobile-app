  "lesson": {
    "lesson_title": "Adverb Usage and Common Errors",
    "lesson_summary": "A review of the adverb mistakes learners make most often, one kind per page, each with a correction: good for well, an adjective for an adverb, an adverb after a linking verb, an adverb between a verb and its object, a frequency adverb in the wrong place, hard and hardly confused, and -ly spelling slips. The rules themselves were taught earlier in this chapter. Double negatives and comparison mistakes are left to Stages 2.4 and 5.2.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Correct mistakes in choosing an adverb or adjective.",
        "success_criteria": [
          "Fix good for well.",
          "Fix an adjective used for an adverb, and an adverb after a linking verb."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Correct mistakes in adverb position.",
        "success_criteria": [
          "Move an adverb out from between a verb and its object.",
          "Put a frequency adverb before the main verb."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Correct mistakes in meaning and spelling.",
        "success_criteria": [
          "Fix hardly used for hard.",
          "Spell -ly adverbs correctly."
        ]
      }
    ],
    "estimated_duration_minutes": 14,
    "total_pages": 9
  },
