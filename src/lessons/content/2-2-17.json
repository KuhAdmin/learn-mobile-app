          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "She sings good in the school choir.",
            "correct": "She sings well in the school choir.",
            "reason": "Well tells how she sings. Good describes nouns."
          },
          "related_learning_objective_ids": [
            "OBJ001"
          ]
        }
      ],
      "key_takeaway": "How someone does it: well.",
