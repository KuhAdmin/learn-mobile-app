      "title": "Adverb Mistake Checklist",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "introduction": "Before you finish writing, check:",
          "list_style": "bulleted",
          "items": [
            "How someone does it: well, not good.",
            "Describe an action with the adverb.",
            "After a linking verb, use the adjective.",
            "Keep the verb and its object together.",
            "Frequency goes before the main verb.",
            "Hard means with effort; hardly means almost not.",
            "Check the -ly spelling."
          ]
        }
      ],
      "key_takeaway": "Check your adverbs before you finish.",
