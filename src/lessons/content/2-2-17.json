      ],
      "title": "Spot and Fix Adverb Mistakes",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Adverbs are easy to get almost right. This lesson collects the common slips and shows how to fix each one."
        },
        {
          "block_id": "BLOCK002",
          "type": "list",
          "introduction": "Watch out for:",
          "list_style": "bulleted",
          "items": [
            "an adjective where an adverb belongs, or the other way round",
            "an adverb in the wrong place",
            "look-alike words and -ly spelling"
          ]
        }
      ],
      "key_takeaway": "Adverb mistakes come in a few kinds.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 53,
        "density_status": "passed",
