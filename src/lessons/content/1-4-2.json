  "lesson": {
    "lesson_title": "Indefinite Article – A",
    "lesson_summary": "Learners use a to mean one, not a particular one, especially when something is mentioned for the first time. They use it only with singular countable nouns, use it to say what someone or something is ('My aunt is a pilot.'), and meet a meaning 'in each' (twice a week). Choosing a or an by sound is left to 1-4-3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use a for one, not a particular one.",
        "success_criteria": [
          "Use a for a first mention.",
          "Use a only with singular countable nouns."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use a for jobs, descriptions and rates.",
        "success_criteria": [
          "Say 'She is a nurse.'",
          "Understand 'twice a week'."
        ]
      }
    ],
    "estimated_duration_minutes": 10,
    "total_pages": 6
  },
