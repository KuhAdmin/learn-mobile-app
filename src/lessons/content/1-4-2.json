  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "One of Many",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A means one, but not a particular one. It is how we bring something new into a conversation."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Look, there's a rainbow over the hills!",
              "highlight": [
                "a rainbow"
              ],
              "explanation": "The rainbow is new to the listener, so the speaker says a rainbow."
            }
          ]
        }
      ],
      "key_takeaway": "A means one, not a particular one.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Saying It for the First Time",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "text",
          "text": "When the listener doesn't know about something yet, introduce it with a."
        },
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "We adopted a kitten from the shelter last week.",
              "highlight": [
                "a kitten"
              ],
              "explanation": "The kitten is new news for the listener, so it is introduced with a."
            }
          ]
        }
      ],
      "key_takeaway": "Use a when you first mention something.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Only One, Only Countable",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use a only with a singular noun that you can count: a mango, a chair. Never use it with plural or uncountable nouns.",
          "scope": "The indefinite article a",
          "examples": [
            {
              "sentence": "Rohan peeled a mango after school.",
              "highlight": [
                "a mango"
              ],
              "explanation": "Mango is singular and countable, so a fits."
            }
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "note",
          "title": "Not with",
          "text": "a sugar, a chairs."
        }
      ],
      "key_takeaway": "A goes with one countable thing.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A for Jobs and Descriptions",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "Use a to say what someone's job is, or what someone or something is like."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "My aunt is a pilot.",
              "highlight": [
                "a pilot"
              ],
              "explanation": "A comes before the job."
            },
            {
              "sentence": "That was a brilliant match.",
              "highlight": [
                "a brilliant match"
              ],
              "explanation": "A comes before a description of the match."
            }
          ]
        }
      ],
      "key_takeaway": "She is a pilot, not she is pilot.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A Meaning 'In Each'",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "text",
          "text": "A can mean 'in each' or 'for each': twice a week, fifty rupees a kilo."
        },
        {
          "block_id": "BLOCK010",
          "type": "example",
          "examples": [
            {
              "sentence": "We water the tulsi plant twice a day.",
              "highlight": [
                "a day"
              ],
              "explanation": "Twice a day means two times in each day."
            }
          ]
        }
      ],
      "key_takeaway": "Twice a week means twice in each week.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
