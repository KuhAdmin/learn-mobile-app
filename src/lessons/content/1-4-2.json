      ],
      "title": "The Article A: Recap",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "A means one, not a particular one.",
            "Use a when you first mention something.",
            "A only goes with one countable thing.",
            "Use a for jobs and descriptions.",
            "A can mean 'in each': twice a day."
          ]
        }
      ],
      "key_takeaway": "Use a for one new, countable thing.",
