      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "A Friend of Mine",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "'A friend of mine' means one of my friends. The possessive pronoun comes after of."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "A neighbour of ours keeps bees in her garden.",
              "highlight": [
                "ours"
              ],
              "explanation": "A neighbour of ours means one of our neighbours."
            }
          ]
        }
      ],
      "key_takeaway": "A friend of mine means one of my friends.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
