  "lesson": {
    "lesson_title": "Possessive Pronouns",
    "lesson_summary": "Learners meet mine, yours, his, hers, ours and theirs: pronouns that show who owns something and stand alone, with no noun after them. They use them to answer 'whose?' questions, learn that they never take an apostrophe, and meet 'a friend of mine'. Words like my and their before a noun come in 1-3-4; possessive nouns with 's were taught in 1-2-11.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise the possessive pronouns.",
        "success_criteria": [
          "Name the possessive pronoun for each person."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use a possessive pronoun in place of a noun phrase.",
        "success_criteria": [
          "Replace 'my bag' with mine.",
          "Answer a whose question with a possessive pronoun."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Write possessive pronouns without apostrophes and use 'of mine'.",
        "success_criteria": [
          "Write hers, ours and theirs with no apostrophe.",
          "Explain 'a friend of mine'."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
