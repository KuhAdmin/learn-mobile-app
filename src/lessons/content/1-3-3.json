  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "That One Is Mine",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Some pronouns tell us who owns something, and they stand alone, with no noun after them."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The blue towel is mine, and the striped one is yours.",
              "highlight": [
                "mine",
                "yours"
              ],
              "explanation": "Mine means my towel, and yours means your towel. No noun follows them."
            }
          ]
        }
      ],
      "key_takeaway": "Possessive pronouns show who owns something.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Meet the Owner Words",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Each person has its own possessive pronoun:",
          "list_style": "bulleted",
          "items": [
            "mine – I own it",
            "yours – you own it",
            "his – he owns it",
            "hers – she owns it",
            "ours – we own it",
            "theirs – they own it"
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Its",
          "text": "Its is almost never used on its own like this."
        }
      ],
      "key_takeaway": "Mine, yours, his, hers, ours, theirs.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "No Noun After It",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "A possessive pronoun takes the place of a whole phrase such as 'our painting', so no noun follows it."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Your painting is bright, but ours is brighter.",
              "highlight": [
                "ours"
              ],
              "explanation": "Ours means our painting, so the noun isn't repeated."
            },
            {
              "sentence": "Grandpa's chair is by the window, and theirs is by the door.",
              "highlight": [
                "theirs"
              ],
              "explanation": "Theirs means their chair."
            }
          ]
        }
      ],
      "key_takeaway": "A possessive pronoun replaces the owner and the thing.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Answering Whose?",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "A possessive pronoun makes a quick answer to a question that starts with whose."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "Whose scarf is on the bench? It's his.",
              "highlight": [
                "his"
              ],
              "explanation": "His answers whose and means his scarf."
            }
          ]
        }
      ],
      "key_takeaway": "Answer whose with mine, his, hers and so on.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Owner Words Without Apostrophes",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Possessive pronouns never take an apostrophe: yours, hers, ours, theirs.",
          "scope": "Possessive pronouns; possessive nouns such as Asha's still take 's",
          "examples": [
            {
              "sentence": "The last slice of pizza is yours.",
              "highlight": [
                "yours"
              ],
              "explanation": "Yours already shows ownership, so it needs no apostrophe."
            }
          ]
        }
      ],
      "key_takeaway": "Hers, ours and theirs never have an apostrophe.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
