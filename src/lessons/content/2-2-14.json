  "lesson": {
    "lesson_title": "Adverb Position in Sentences",
    "lesson_summary": "Adverbs have three homes: the front, the middle and the end. This lesson brings together the position rules from 2-2-2 to 2-2-13: which kinds go where, the usual end order (manner, place, time), keeping a verb and its object together, and moving an adverb to the front for effect. Inverted word order is left to Stage 2.4.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Name the three adverb positions and what goes in each.",
        "success_criteria": [
          "Say which kinds of adverb go in front, middle and end."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Order adverbs at the end of a sentence.",
        "success_criteria": [
          "Use manner, place, time.",
          "Put place before time."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Keep the verb and its object together.",
        "success_criteria": [
          "Move an adverb out from between a verb and its object.",
          "Move an adverb to the front for effect."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
