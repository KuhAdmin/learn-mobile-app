  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Front, Middle and End",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Adverbs have three main places in a sentence: the front, the middle and the end. Each kind has a usual home."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Suddenly, the dog began to bark.",
              "highlight": [
                "Suddenly"
              ],
              "explanation": "Suddenly is in the front position."
            }
          ]
        }
      ],
      "key_takeaway": "Adverbs have three main homes.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Who Lives Where?",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Front: sentence adverbs, perhaps and maybe, and time to set the scene (with a comma)",
            "Middle: frequency, certainty, also, still, just (before the main verb, after be or the first helper)",
            "End: manner, place, time, too, any more"
          ]
        }
      ],
      "key_takeaway": "Know the home of each kind.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Middle Position",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "With a helping verb, the middle position is after the first helper and before the main verb."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "My aunt has always lived by the sea.",
              "highlight": [
                "has always lived"
              ],
              "explanation": "Always comes after the helper has and before lived."
            }
          ]
        }
      ],
      "key_takeaway": "Middle means after the first helper.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 44,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Manner, Place, Time",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "When several adverbs go at the end, the usual order is manner, then place, then time.",
          "scope": "End position",
          "examples": [
            {
              "sentence": "She sang sweetly at the concert last night.",
              "highlight": [
                "sweetly",
                "at the concert",
                "last night"
              ],
              "explanation": "How (sweetly), where (at the concert), when (last night)."
            }
          ]
        }
      ],
      "key_takeaway": "At the end: how, where, when.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Place Before Time",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "With only place and time at the end, place usually comes first.",
          "scope": "Place and time",
          "examples": [
            {
              "sentence": "We are going to the zoo tomorrow.",
              "highlight": [
                "to the zoo",
                "tomorrow"
              ],
              "explanation": "Where (to the zoo) comes before when (tomorrow)."
            }
          ]
        }
      ],
      "key_takeaway": "Where comes before when.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Never Between Verb and Object",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE008",
          "rule_text": "An adverb does not go between a verb and its object. Put it after the object.",
          "scope": "Verbs with objects",
          "examples": [
            {
              "sentence": "Anil speaks Tamil fluently.",
              "highlight": [
                "fluently"
              ],
              "explanation": "Speaks and its object Tamil stay together; fluently comes after."
            }
          ]
        },
        {
          "block_id": "BLOCK009",
          "type": "note",
          "title": "Not this",
          "text": "Anil speaks fluently Tamil."
        }
      ],
      "key_takeaway": "Verb and object stay side by side.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 50,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Moving to the Front for Effect",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "Writers sometimes move a manner adverb to the front to build suspense. A comma follows it."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "Slowly, the old door creaked open.",
              "highlight": [
                "Slowly"
              ],
              "explanation": "Starting with slowly makes the reader wait for what comes next."
            }
          ]
        }
      ],
      "key_takeaway": "Move an adverb forward to build a mood.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 44,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Adverb Position: Recap",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Front: comments, perhaps, scene-setting time.",
            "Middle: frequency, certainty, also, still.",
            "End: manner, then place, then time.",
            "Never between a verb and its object.",
            "Front for effect, with a comma."
          ]
        }
      ],
      "key_takeaway": "Front, middle or end: choose the home.",
