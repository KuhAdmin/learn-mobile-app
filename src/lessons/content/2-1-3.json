  "lesson": {
    "lesson_title": "Action Verbs and Stative Verbs",
    "lesson_summary": "Learners sort verbs into action verbs (something happens, with the body or the mind) and stative verbs (a state that simply is true): feelings, thinking, having, senses and being. They use the test 'Is something happening?' to tell them apart. Using stative verbs correctly, and verbs with both meanings, is taught in 2-1-8.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise action verbs.",
        "success_criteria": [
          "Spot physical and mental actions."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Recognise stative verbs.",
        "success_criteria": [
          "Name the groups of stative verbs.",
          "Use the 'Is something happening?' test."
        ]
      }
    ],
    "estimated_duration_minutes": 10,
    "total_pages": 6
  },
