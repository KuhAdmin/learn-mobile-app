  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "Doing or Being?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Some verbs show something happening. Others show a state: something that simply is true."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The toddler giggles because she loves the swing.",
              "highlight": [
                "giggles",
                "loves"
              ],
              "explanation": "Giggles is something happening; loves is a feeling, a state."
            }
          ]
        }
      ],
      "key_takeaway": "Verbs show actions or states.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Action Verbs",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "text",
          "text": "Action verbs show something happening. The action can be with the body or in the mind."
        },
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "The goalkeeper dived for the ball.",
              "highlight": [
                "dived"
              ],
              "explanation": "Diving is a body action."
            },
            {
              "sentence": "Mira decided to join the choir.",
              "highlight": [
                "decided"
              ],
              "explanation": "Deciding happens in the mind, but it is still an action."
            }
          ]
        }
      ],
      "key_takeaway": "Actions can be of the body or the mind.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Kinds of Stative Verbs",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Feelings: love, hate, prefer",
            "Thinking: know, believe, understand",
            "Having: own, belong, include",
            "Senses: hear, smell, taste",
            "Being: seem, contain, weigh"
          ]
        }
      ],
      "key_takeaway": "States are feelings, thoughts, having, senses and being.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "States in Sentences",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Stative verbs describe how things are, not what anyone is doing."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "This jar contains wild honey.",
              "highlight": [
                "contains"
              ],
              "explanation": "Nothing is happening; contains describes what is inside."
            },
            {
              "sentence": "Arjun believes in ghosts.",
              "highlight": [
                "believes"
              ],
              "explanation": "Believes describes what Arjun thinks, a state."
            }
          ]
        }
      ],
      "key_takeaway": "Stative verbs describe how things are.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Is Something Happening?",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Ask: is something happening, with a start and an end? Then it is an action. If it is simply true for a while, it is a state.",
          "scope": "Telling action verbs from stative verbs",
          "examples": [
            {
              "sentence": "The orchestra owns three grand pianos.",
              "highlight": [
                "owns"
              ],
              "explanation": "Nothing happens; owning is simply true, so owns is stative."
            }
          ]
        }
      ],
      "key_takeaway": "Happening means action; simply true means state.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "Action and State: Recap",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Action verbs: something happens (dive, decide).",
            "Stative verbs: something is true (know, own).",
            "States include feelings, thinking, having, senses and being.",
            "Ask: is something happening?"
          ]
        }
      ],
      "key_takeaway": "Sort verbs into doing and being.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 30,
