  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Stacking Determiners",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Sometimes two or three determiners come before one noun. They always follow the same order."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Both my older brothers play the tabla.",
              "highlight": [
                "Both my"
              ],
              "explanation": "Both comes first, then my, then the describing word and the noun."
            }
          ]
        }
      ],
      "key_takeaway": "Determiners stack in a fixed order.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "First, Middle and Last Slots",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Think of three slots before the noun:",
          "list_style": "numbered",
          "items": [
            "First: all, both, half",
            "Middle: a, the, this, those, my, Ravi's",
            "Last: numbers, first, next, many, few"
          ]
        }
      ],
      "key_takeaway": "First slot, middle slot, last slot, then the noun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Only One Middle Word",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use only one word from the middle slot: one article, demonstrative or possessive. Never 'the my book' or 'this your pen'.",
          "scope": "Articles, demonstratives and possessives together",
          "examples": [
            {
              "sentence": "These two kittens belong to Asha.",
              "highlight": [
                "These two"
              ],
              "explanation": "These is the only middle-slot word; two comes after it."
            }
          ]
        }
      ],
      "key_takeaway": "Only one of a, the, this or my.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "All the, Both My, Half the",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "All, both and half come before the middle word."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "All the mangoes in the crate were ripe.",
              "highlight": [
                "All the"
              ],
              "explanation": "All (first slot) comes before the (middle slot)."
            },
            {
              "sentence": "We finished half the cake before lunch.",
              "highlight": [
                "half the"
              ],
              "explanation": "Half (first slot) comes before the (middle slot)."
            }
          ]
        }
      ],
      "key_takeaway": "All the, never the all.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Numbers Come After",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "Numbers, ordinals and words such as many and few come after the middle word."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "My first two attempts at the puzzle failed.",
              "highlight": [
                "My first two"
              ],
              "explanation": "My (middle), then first and two (last slot)."
            }
          ]
        }
      ],
      "key_takeaway": "My first two, not first my two.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
