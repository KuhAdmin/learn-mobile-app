  "lesson": {
    "lesson_title": "Determiner Order and Combinations",
    "lesson_summary": "Learners put several determiners before one noun in the right order, using three slots: all, both or half first; one article, demonstrative or possessive in the middle; and numbers, ordinals, many or few last. They practise common combinations (all the, both my, half the, these two, my first two) and finish with a summary of the whole chapter. Adjective order is left to 1-5-13.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use the three determiner slots.",
        "success_criteria": [
          "Put all, both and half first.",
          "Use only one middle-slot word."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Build common determiner combinations.",
        "success_criteria": [
          "Say both my, all the and half the.",
          "Put numbers after the middle word: these two, my first two."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 6
  },
