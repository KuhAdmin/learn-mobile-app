  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Doing Something to Yourself",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Sometimes the person who does an action also receives it. Then we use a pronoun that ends in -self or -selves."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Priya looked at herself in the shop window.",
              "highlight": [
                "herself"
              ],
              "explanation": "Priya does the looking and Priya is looked at, so we use herself."
            }
          ]
        }
      ],
      "key_takeaway": "A -self word points back to the doer.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Self Family",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Each personal pronoun has a reflexive partner:",
          "list_style": "bulleted",
          "items": [
            "I → myself",
            "you (one person) → yourself",
            "he → himself",
            "she → herself",
            "it → itself",
            "we → ourselves",
            "you (more than one) → yourselves",
            "they → themselves"
          ]
        }
      ],
      "key_takeaway": "Every personal pronoun has a -self partner.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "One Self, Many Selves",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use -self for one person or thing and -selves for more than one.",
          "scope": "Reflexive pronouns",
          "examples": [
            {
              "sentence": "The kitten licked itself clean.",
              "highlight": [
                "itself"
              ],
              "explanation": "One kitten, so -self: itself."
            },
            {
              "sentence": "We introduced ourselves to the new neighbours.",
              "highlight": [
                "ourselves"
              ],
              "explanation": "We is more than one, so -selves: ourselves."
            }
          ]
        }
      ],
      "key_takeaway": "One takes -self; more than one takes -selves.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Her or Herself?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "comparison",
          "items": [
            {
              "label": "Someone else",
              "description": "The receiver is a different person.",
              "example": "Nisha blamed her for the broken vase."
            },
            {
              "label": "The same person",
              "description": "The receiver is the doer.",
              "example": "Nisha blamed herself for the broken vase."
            }
          ],
          "comparison_points": [
            "In the first sentence, her is another girl.",
            "In the second, herself is Nisha."
          ],
          "conclusion": "If the doer and the receiver are the same, use the -self word."
        }
      ],
      "key_takeaway": "Same person? Use the -self word.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Everyday Phrases With -self",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Some verbs often take a reflexive pronoun: enjoy yourself, hurt yourself, help yourself, introduce yourself."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Help yourselves to the samosas!",
              "highlight": [
                "yourselves"
              ],
              "explanation": "The guests serve themselves, so the host says help yourselves."
            },
            {
              "sentence": "Did you enjoy yourself at the fair?",
              "highlight": [
                "yourself"
              ],
              "explanation": "You did the enjoying and received it, so yourself is used."
            }
          ]
        }
      ],
      "key_takeaway": "Enjoy, hurt and help often take a -self word.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "By Myself Means Alone",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "By with a reflexive pronoun means alone, with no help from anyone."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "Grandpa built the garden shed by himself.",
              "highlight": [
                "by himself"
              ],
              "explanation": "By himself means Grandpa built it alone."
            }
          ]
        }
      ],
      "key_takeaway": "By myself means alone.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
