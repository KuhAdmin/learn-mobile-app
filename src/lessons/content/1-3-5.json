  "lesson": {
    "lesson_title": "Reflexive Pronouns",
    "lesson_summary": "Learners meet myself, yourself, himself, herself, itself, ourselves, yourselves and themselves, used when the doer and the receiver of an action are the same. They tell singular -self from plural -selves, compare 'blamed her' with 'blamed herself', meet common phrases such as help yourself, and learn that 'by myself' means alone. Using these words for emphasis is left to 1-3-6.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Name the reflexive pronouns.",
        "success_criteria": [
          "Match each personal pronoun with its reflexive form.",
          "Use -self for one and -selves for more than one."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use a reflexive pronoun when the doer and receiver are the same.",
        "success_criteria": [
          "Choose herself rather than her when the person is the same.",
          "Use common phrases such as enjoy yourself."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use 'by myself' to mean alone.",
        "success_criteria": [
          "Explain 'by himself'."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
