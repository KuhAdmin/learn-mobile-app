  "lesson": {
    "lesson_title": "Formation of Adverbs",
    "lesson_summary": "Most adverbs are built by adding -ly to an adjective. Learners apply the spelling changes (-y to -ily, -le to -ly, -ll to -lly, -ic to -ically, true to truly), use the endings -wards and -wise, and recognise adverbs that have no ending at all. Comparative adverbs are left to Stage 5.2; adjectives ending in -ly were covered in 2-2-15.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Build adverbs with -ly and spell them correctly.",
        "success_criteria": [
          "Spell happily, gently, fully and basically."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use the endings -wards and -wise.",
        "success_criteria": [
          "Use backwards and clockwise."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Recognise adverbs with no ending.",
        "success_criteria": [
          "Name adverbs like soon and often.",
          "Use well for good."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
