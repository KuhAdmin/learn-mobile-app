  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Building Adverbs",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Most adverbs are made by adding -ly to an adjective."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The sea was calm, and the boat moved calmly.",
              "highlight": [
                "calm",
                "calmly"
              ],
              "explanation": "The adjective calm becomes the adverb calmly."
            }
          ]
        }
      ],
      "key_takeaway": "Adjective + -ly makes most adverbs.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 33,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Just Add -ly",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "For most adjectives, add -ly:",
          "list_style": "bulleted",
          "items": [
            "quick → quickly",
            "sudden → suddenly",
            "brave → bravely",
            "polite → politely",
            "careless → carelessly"
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Keep the e",
          "text": "Words ending in -e usually keep it: brave → bravely."
        }
      ],
      "key_takeaway": "Most adjectives just add -ly.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 31,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Y Becomes I",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "list",
          "introduction": "When an adjective ends in a consonant + y:",
          "list_style": "bulleted",
          "items": [
            "happy → happily",
            "easy → easily",
            "lucky → luckily",
            "angry → angrily",
            "busy → busily"
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "The puppy wagged its tail happily.",
              "highlight": [
                "happily"
              ],
              "explanation": "Happy changes y to i before -ly."
            }
          ]
        }
      ],
      "key_takeaway": "Consonant + y: change y to i, add -ly.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 36,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Endings That Change",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "-le → -ly: gentle → gently, simple → simply",
            "-ll → -lly: full → fully",
            "-ic → -ically: basic → basically, tragic → tragically",
            "true → truly (the e goes)"
          ]
        },
        {
          "block_id": "BLOCK008",
          "type": "note",
          "title": "One exception",
          "text": "Public → publicly, not publically."
        }
      ],
      "key_takeaway": "Watch -le, -ll, -ic and true.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "-wards Shows Direction",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "text",
          "text": "The ending -wards (or -ward) makes adverbs of direction."
        },
        {
          "block_id": "BLOCK010",
          "type": "example",
          "examples": [
            {
              "sentence": "The car rolled backwards down the slope.",
              "highlight": [
                "backwards"
              ],
              "explanation": "Backwards means towards the back."
            },
            {
              "sentence": "After the match, the fans headed homewards.",
              "highlight": [
                "homewards"
              ],
              "explanation": "Homewards means towards home."
            }
          ]
        },
        {
          "block_id": "BLOCK011",
          "type": "note",
          "title": "More",
          "text": "upwards, downwards, forwards, onwards"
        }
      ],
      "key_takeaway": "-wards means in that direction.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "-wise for Direction or Manner",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "text",
          "text": "The ending -wise can mean \"in the direction of\" or \"in the way of\"."
        },
        {
          "block_id": "BLOCK013",
          "type": "example",
          "examples": [
            {
              "sentence": "Turn the lid clockwise to close the jar.",
              "highlight": [
                "clockwise"
              ],
              "explanation": "Clockwise means the way the hands of a clock move."
            }
          ]
        },
        {
          "block_id": "BLOCK014",
          "type": "note",
          "title": "More",
          "text": "Anticlockwise is the opposite direction. Likewise means in the same way."
        }
      ],
      "key_takeaway": "Clockwise: the way a clock turns.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 56,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Adverbs With No Ending",
      "content": [
        {
          "block_id": "BLOCK015",
          "type": "text",
          "text": "Many common adverbs have no special ending: soon, often, here, very, never. A few have the same form as their adjective (2-2-15), and good becomes well."
        },
        {
          "block_id": "BLOCK016",
          "type": "example",
          "examples": [
            {
              "sentence": "The guests will arrive soon.",
              "highlight": [
                "soon"
              ],
              "explanation": "Soon is an adverb of time with no ending."
            }
          ]
        }
      ],
      "key_takeaway": "Some adverbs are not built from anything.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Building Adverbs: Recap",
      "content": [
        {
          "block_id": "BLOCK017",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Most adjectives add -ly.",
            "happy → happily; gentle → gently; full → fully.",
            "basic → basically; true → truly.",
            "-wards and -wise show direction or manner.",
            "Some adverbs have no ending; good → well."
          ]
        }
      ],
      "key_takeaway": "Know the rule, then the changes.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    }
