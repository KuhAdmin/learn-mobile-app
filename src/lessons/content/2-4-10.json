        "OBJ003"
      ],
      "title": "SVO Pattern: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "SVO order is fixed.",
            "Swap the subject and object and the meaning changes.",
            "Describing words and adverbials keep the pattern.",
            "Join two SVO sentences with and, or share the subject."
          ]
        }
      ],
      "key_takeaway": "Keep the order, then build it up.",
