  "lesson": {
    "lesson_title": "Subject–Verb–Object Pattern",
    "lesson_summary": "The SVO pattern is the most common English sentence. Learners see that its order is fixed (swap the subject and object and the story changes), grow the subject and object with describing words, add adverbials without changing the pattern, and join two SVO sentences, or share one subject between two verbs. What can be an object was taught in 2-4-3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Keep SVO order.",
        "success_criteria": [
          "Explain how swapping subject and object changes the meaning."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Grow an SVO sentence.",
        "success_criteria": [
          "Add describing words and adverbials."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Join SVO sentences.",
        "success_criteria": [
          "Join two with and.",
          "Share one subject between two verbs."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
