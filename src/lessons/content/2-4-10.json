  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Who Did What to What",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "The SVO pattern is the most common English sentence: a subject, a verb and an object."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The goat ate my homework!",
              "highlight": [
                "The goat",
                "my homework"
              ],
              "explanation": "The goat is the subject, ate is the verb, my homework is the object."
            }
          ]
        }
      ],
      "key_takeaway": "SVO: subject, verb, object.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Swap Them, Change the Story",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "comparison",
          "items": [
            {
              "label": "The hen first",
              "description": "The hen does the pecking.",
              "example": "The hen pecked the rooster."
            },
            {
              "label": "The rooster first",
              "description": "The rooster does it.",
              "example": "The rooster pecked the hen."
            }
          ],
          "comparison_points": [
            "In the first sentence, the hen does the action.",
            "In the second, the same words in a new order tell a different story."
          ],
          "conclusion": "In English, the order of the words shows who does what."
        }
      ],
      "key_takeaway": "Order shows who does what.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 65,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Subject, Verb, Object",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "In an SVO statement, the order is fixed: subject, then verb, then object.",
          "scope": "SVO order",
          "examples": [
            {
              "sentence": "Grandma feeds the sparrows every morning.",
              "highlight": [
                "Grandma",
                "feeds",
                "the sparrows"
              ],
              "explanation": "Subject, verb, object, then an extra."
            }
          ]
        }
      ],
      "key_takeaway": "Keep the three in that order.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Grow the Subject and Object",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "Add describing words to the subject or object, and the sentence is still SVO.",
          "scope": "Longer parts",
          "examples": [
            {
              "sentence": "The small boy in the red cap caught the heavy cricket ball.",
              "highlight": [
                "The small boy in the red cap",
                "the heavy cricket ball"
              ],
              "explanation": "A long subject and a long object, but still SVO."
            }
          ]
        }
      ],
      "key_takeaway": "Describing words keep the pattern.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 56,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Add Adverbials",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "rule",
          "rule_id": "RULE006",
          "rule_text": "Add how, where or when, and the sentence is still SVO.",
          "scope": "SVO + adverbials",
          "examples": [
            {
              "sentence": "Yesterday, our class planted twenty saplings near the gate.",
              "highlight": [
                "our class planted twenty saplings"
              ],
              "explanation": "Yesterday and near the gate are extras."
            }
          ]
        }
      ],
      "key_takeaway": "Extras don't change SVO.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 39,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Two SVO Sentences With And",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "Two SVO sentences can be joined with a comma and and.",
          "scope": "Joining",
          "examples": [
            {
              "sentence": "Asha washed the cups, and Ravi dried them.",
              "highlight": [
                "Asha washed the cups",
                "Ravi dried them"
              ],
              "explanation": "Each half has its own subject, verb and object."
            }
          ]
        }
      ],
      "key_takeaway": "And joins two complete sentences.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 43,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Sharing a Subject",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "When the subject is the same, say it once and join the two verbs with and."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "Mum peeled the mangoes and cut them into slices.",
              "highlight": [
                "peeled the mangoes",
                "cut them into slices"
              ],
              "explanation": "Mum is the subject of both verbs."
            }
          ]
        }
      ],
      "key_takeaway": "One subject, two verbs with objects.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
