  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Finishing the Verb's Thought",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Many verbs aren't complete on their own. The words that complete them are called complements."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Please put the milk in the fridge.",
              "highlight": [
                "put",
                "the milk",
                "in the fridge"
              ],
              "explanation": "Put needs both what (the milk) and where (in the fridge)."
            }
          ]
        }
      ],
      "key_takeaway": "Complements finish what the verb starts.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Kinds of Complement",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "An object: found her keys",
            "A word after a linking verb: seems tired",
            "A place phrase: put it on the shelf",
            "A preposition the verb needs: listen to the birds",
            "A that-clause: hope that it rains"
          ]
        }
      ],
      "key_takeaway": "Objects, describing words, places, prepositions and clauses can complete a verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Verbs That Need Two Parts",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Some verbs, such as put and place, need an object and a place. Leave either out and the sentence feels unfinished.",
          "scope": "Verbs such as put and place",
          "examples": [
            {
              "sentence": "Arjun placed the vase on the windowsill.",
              "highlight": [
                "placed"
              ],
              "explanation": "Placed needs what (the vase) and where (on the windowsill)."
            }
          ]
        }
      ],
      "key_takeaway": "Put needs what and where.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Verbs That Need a Preposition",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "Some verbs always take a particular preposition before what follows: depend on, listen to, belong to, wait for."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "We waited for the ferry in the rain.",
              "highlight": [
                "waited for"
              ],
              "explanation": "Wait takes for: we wait for something."
            },
            {
              "sentence": "Puppies depend on their mothers.",
              "highlight": [
                "depend on"
              ],
              "explanation": "Depend takes on."
            }
          ]
        }
      ],
      "key_takeaway": "Learn depend on, listen to, wait for as pairs.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Complete or Not?",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "comparison",
          "items": [
            {
              "label": "Unfinished",
              "description": "Something the verb needs is missing.",
              "example": "Riya put the books."
            },
            {
              "label": "Complete",
              "description": "The verb has everything it needs.",
              "example": "Riya put the books on the top shelf."
            }
          ],
          "comparison_points": [
            "In the first sentence, we wonder where she put them.",
            "In the second, the place phrase completes the verb."
          ],
          "conclusion": "If the listener would ask 'where?' or 'what?', the complement is missing."
        }
      ],
      "key_takeaway": "Missing where or what? Add the complement.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "Verb Complements: Recap",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Complements complete the verb.",
            "They can be objects, describing words, places, prepositions or that-clauses.",
            "Put and place need what and where.",
            "Depend on, listen to, wait for come as pairs."
          ]
        }
      ],
      "key_takeaway": "Give each verb everything it needs.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 30,
