  "lesson": {
    "lesson_title": "Verb Complements",
    "lesson_summary": "Learners see that many verbs need words after them to be complete: an object, a word after a linking verb, a place phrase, a preposition the verb always takes (depend on, listen to), or a that-clause. They meet verbs such as put that need two parts. Objects, complements and sentence patterns are taught in depth in Stage 2.4, and clauses in Stage 4.4.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Recognise the kinds of verb complements.",
        "success_criteria": [
          "Name an object, a word after a linking verb, a place phrase and a that-clause."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Complete verbs that need more than one part or a preposition.",
        "success_criteria": [
          "Use put with an object and a place.",
          "Use depend on, listen to and wait for."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
