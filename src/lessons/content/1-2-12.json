  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002"
      ],
      "title": "Building New Nouns",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Add a small ending to a word and you can build a new noun: enjoy, enjoyment; dark, darkness; art, artist. These endings are called suffixes."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The darkness didn't spoil our enjoyment of the show.",
              "highlight": [
                "darkness",
                "enjoyment"
              ],
              "explanation": "Dark + ness and enjoy + ment both make nouns."
            }
          ]
        }
      ],
      "key_takeaway": "A suffix can turn a word into a noun.",
      "page_audit": {
        "primary_objective_count": 2,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "From Verbs: -ment and -tion",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Many verbs become nouns with -ment or -tion:",
          "list_style": "bulleted",
          "items": [
            "agree → agreement",
            "move → movement",
            "invite → invitation",
            "celebrate → celebration"
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "We sent an invitation to every neighbour.",
              "highlight": [
                "invitation"
              ],
              "explanation": "Invite + tion makes the noun invitation."
            }
          ]
        }
      ],
      "key_takeaway": "-ment and -tion turn actions into nouns.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
