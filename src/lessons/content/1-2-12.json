      "title": "Watch the Spelling",
      "content": [
        {
          "block_id": "BLOCK015",
          "type": "text",
          "text": "Sometimes the base word changes when you add a suffix."
        },
        {
          "block_id": "BLOCK016",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Change y to i: lazy → laziness",
            "Drop the e: create → creation",
            "Change d to s: decide → decision"
          ]
        },
        {
          "block_id": "BLOCK017",
          "type": "example",
          "examples": [
            {
              "sentence": "Their laziness cost them the game.",
              "highlight": [
                "laziness"
              ],
              "explanation": "Lazy changes y to i before -ness: laziness."
            }
          ]
        }
      ],
      "key_takeaway": "Check the spelling when you add a suffix.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
