  "lesson": {
    "lesson_title": "Noun Formation and Word Building",
    "lesson_summary": "Learners build nouns by adding suffixes: -ment, -tion, -ance, -ence and -al to verbs; -ness, -ity, -th and -dom to adjectives; -er, -or, -ist and -ian for people; and -ship and -hood for relationships and stages of life. They also notice spelling changes when a suffix is added. Using the same word as a noun and a verb without a suffix was covered in 1.1.5.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Form nouns from verbs with -ment, -tion, -ance, -ence and -al.",
        "success_criteria": [
          "Turn a verb such as agree into a noun (agreement)."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Form nouns from adjectives with -ness, -ity, -th and -dom.",
        "success_criteria": [
          "Turn an adjective such as warm into a noun (warmth)."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Form nouns for people with -er, -or, -ist and -ian.",
        "success_criteria": [
          "Name the person who does an activity (librarian, artist)."
        ]
      },
      {
        "objective_id": "OBJ004",
        "description": "Form nouns with -ship and -hood.",
        "success_criteria": [
          "Turn friend into friendship and neighbour into neighbourhood."
        ]
      },
      {
        "objective_id": "OBJ005",
        "description": "Spell nouns correctly when the base word changes.",
        "success_criteria": [
          "Change y to i before -ness.",
          "Spell decision and creation correctly."
        ]
      }
    ],
    "estimated_duration_minutes": 15,
    "total_pages": 9
  },
