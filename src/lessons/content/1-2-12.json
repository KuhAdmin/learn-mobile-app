          "introduction": "Other verbs use -ance, -ence or -al:",
          "list_style": "bulleted",
          "items": [
            "perform → performance",
            "exist → existence",
            "arrive → arrival",
            "refuse → refusal"
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Her arrival surprised the whole family.",
              "highlight": [
                "arrival"
              ],
              "explanation": "Arrive + al makes the noun arrival."
            }
          ]
        }
      ],
      "key_takeaway": "-ance, -ence and -al also make nouns from verbs.",
