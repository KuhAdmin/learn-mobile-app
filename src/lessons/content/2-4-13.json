  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Building With Make, Keep and Call",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "In SVOC sentences (2-4-6), certain verbs take an object plus a complement that names or describes it."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The warm blanket kept the puppy cosy.",
              "highlight": [
                "the puppy cosy"
              ],
              "explanation": "The puppy is the object; cosy describes it."
            }
          ]
        }
      ],
      "key_takeaway": "Some verbs take an object and a complement.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 44,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Make, Keep, Leave, Find + Adjective",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "Make, keep, leave and find are often followed by an object and an adjective.",
          "scope": "Adjective complements",
          "examples": [
            {
              "sentence": "The long queue made everyone grumpy.",
              "highlight": [
                "everyone grumpy"
              ],
              "explanation": "Grumpy describes everyone."
            },
            {
              "sentence": "Leave the gate shut, please.",
              "highlight": [
                "the gate shut"
              ],
              "explanation": "Shut describes the gate."
            }
          ]
        }
      ],
      "key_takeaway": "These verbs often take an adjective.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Name, Call, Elect, Appoint + Noun",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "Name, call, elect and appoint are followed by an object and a noun that renames it.",
          "scope": "Noun complements",
          "examples": [
            {
              "sentence": "The villagers elected Mrs Iyer their leader.",
              "highlight": [
                "Mrs Iyer their leader"
              ],
              "explanation": "Their leader renames Mrs Iyer."
            },
            {
              "sentence": "Everyone calls my uncle Bablu.",
              "highlight": [
                "my uncle Bablu"
              ],
              "explanation": "Bablu renames my uncle."
            }
          ]
        }
      ],
      "key_takeaway": "These verbs take a noun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 54,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Consider and Think",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "Consider and think can take an adjective or a noun complement.",
          "scope": "Either kind",
          "examples": [
            {
              "sentence": "The teachers consider Arjun a true artist.",
              "highlight": [
                "Arjun a true artist"
              ],
              "explanation": "A noun renames Arjun."
            },
            {
              "sentence": "We thought the film brilliant.",
              "highlight": [
                "the film brilliant"
              ],
              "explanation": "An adjective describes the film."
            }
          ]
        }
      ],
      "key_takeaway": "Consider and think take either kind.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Made Her Captain or Made Her a Cake?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "With an object complement",
              "description": "She is the captain.",
              "example": "They made her captain."
            },
            {
              "label": "With two objects",
              "description": "She gets a cake.",
              "example": "They made her a cake."
            }
          ],
          "comparison_points": [
            "In the first sentence, captain renames her.",
            "In the second, a cake is something she receives."
          ],
          "conclusion": "The is-test tells them apart."
        }
      ],
      "key_takeaway": "Same verb, two patterns.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 54,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "The Is-Test Decides",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "Put is between the object and the last part. If it makes sense, the sentence is SVOC. If not, it is SVOO.",
          "scope": "Testing",
          "examples": [
            {
              "sentence": "Dad bought Meena a new dress.",
              "highlight": [
                "Meena a new dress"
              ],
              "explanation": "\"Meena is a new dress\" makes no sense, so this is SVOO."
            }
          ]
        }
      ],
      "key_takeaway": "Object is complement? SVOC. If not, SVOO.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 51,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
