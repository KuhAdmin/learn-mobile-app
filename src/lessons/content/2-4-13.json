  "lesson": {
    "lesson_title": "Subject–Verb–Object–Complement Pattern",
    "lesson_summary": "In SVOC sentences (2-4-6), certain verbs take an object plus a complement. Learners use the three verb groups (make, keep, leave, find + adjective; name, call, elect, appoint + noun; consider and think + either), tell SVOC from SVOO with the is-test (They made her captain / They made her a cake), and build their own SVOC sentences. Make + object + base verb was taught in 2-1-11.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use the verbs that take an object complement.",
        "success_criteria": [
          "Match make and keep with adjectives.",
          "Match elect and call with nouns."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Tell SVOC from SVOO.",
        "success_criteria": [
          "Use the is-test."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Build SVOC sentences.",
        "success_criteria": [
          "Put the complement right after the object."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
