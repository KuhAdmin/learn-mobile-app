            {
              "sentence": "Physics seems hard at first.",
              "highlight": [
                "Physics seems"
              ],
              "explanation": "Physics is one subject, so seems has -s."
            }
          ]
        }
      ],
      "key_takeaway": "News and physics: singular verb.",
