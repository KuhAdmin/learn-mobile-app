  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Nouns and Pronouns as Subjects",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A subject can be a noun or a pronoun. Either way, the verb must match its number."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The postman delivers letters before noon.",
              "highlight": [
                "The postman delivers"
              ],
              "explanation": "One postman, so delivers has -s."
            }
          ]
        }
      ],
      "key_takeaway": "Noun or pronoun, the verb matches it.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 41,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "One Noun, One -s",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "A singular noun subject takes the -s form. A plural noun subject takes the base form.",
          "scope": "Noun subjects",
          "examples": [
            {
              "sentence": "The kettle whistles on the stove.",
              "highlight": [
                "The kettle whistles"
              ],
              "explanation": "One kettle, so whistles has -s."
            },
            {
              "sentence": "The kites fly above the field.",
              "highlight": [
                "The kites fly"
              ],
              "explanation": "More than one kite, so fly has no -s."
            }
          ]
        }
      ],
      "key_takeaway": "Singular noun: -s. Plural noun: no -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 58,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Plurals Without -s",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "Children, people, men, women, mice, teeth and feet are plural, even without -s. They take a plural verb."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "The children want ice cream after lunch.",
              "highlight": [
                "The children want"
              ],
              "explanation": "Children is plural, so want has no -s."
            },
            {
              "sentence": "People queue outside the bakery every morning.",
              "highlight": [
                "People queue"
              ],
              "explanation": "People is plural, so queue has no -s."
            }
          ]
        }
      ],
      "key_takeaway": "Children and people are plural.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 60,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Pronouns and Their Verbs",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "list",
          "introduction": "Each subject pronoun with its verb:",
          "list_style": "bulleted",
          "items": [
            "I play, I am",
            "you play, you are",
            "he, she, it plays; he is",
            "we play, we are",
            "they play, they are"
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "I and you",
          "text": "I and you take the base form: I like, you like. Only he, she and it add -s."
        }
      ],
      "key_takeaway": "Only he, she and it add -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 54,
