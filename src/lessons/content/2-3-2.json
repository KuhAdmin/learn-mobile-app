          "type": "rule",
          "rule_id": "RULE009",
          "rule_text": "Nouns that are always plural (jeans, scissors, glasses, shorts) take a plural verb.",
          "scope": "Always-plural nouns",
          "examples": [
            {
              "sentence": "My new jeans are too long.",
              "highlight": [
                "My new jeans are"
