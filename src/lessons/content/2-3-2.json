  "lesson": {
    "lesson_title": "Singular and Plural Subjects",
    "lesson_summary": "Nouns and pronouns as subjects. Learners give a singular noun the -s form and a plural noun the base form, including plurals without -s (children, people, mice); match each subject pronoun to its verb (I am, you are, she is); and give always-plural nouns (jeans, scissors) a plural verb and -s nouns like news and physics a singular one. Words between the subject and the verb are left to 2-3-14.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Match noun subjects to their verbs.",
        "success_criteria": [
          "Use -s after a singular noun.",
          "Use a plural verb after children and people."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Match pronoun subjects to their verbs.",
        "success_criteria": [
          "Use I am, you are, she is.",
          "Use the base form after I and you."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use the right verb with special nouns.",
        "success_criteria": [
          "Use a plural verb after jeans and scissors.",
          "Use a singular verb after news and physics."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
