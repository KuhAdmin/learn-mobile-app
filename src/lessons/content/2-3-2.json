          "block_id": "BLOCK011",
          "type": "rule",
          "rule_id": "RULE011",
          "rule_text": "A few nouns end in -s but are singular: news, maths, physics. They take a singular verb.",
          "scope": "Singular -s nouns",
          "examples": [
            {
              "sentence": "The news from the village makes Grandma smile.",
