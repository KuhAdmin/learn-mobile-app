      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "One You or Many, Still Are",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "comparison",
          "items": [
            {
              "label": "Talking to one person",
              "description": "You takes are.",
              "example": "Rahul, you are late again!"
            },
            {
              "label": "Talking to many people",
              "description": "You takes are too.",
              "example": "Children, you are all invited."
            }
          ],
          "comparison_points": [
            "In the first sentence, you means one boy.",
            "In the second, you means a whole group."
          ],
          "conclusion": "For one person or many, say you are and you were."
        }
      ],
      "key_takeaway": "You always takes are and were.",
