        "OBJ001"
      ],
      "title": "Adjectives With Partners",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Many adjectives are followed by one particular preposition. Learn the two words together, as a pair."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "My little brother is afraid of thunder.",
              "highlight": [
                "afraid of"
              ],
              "explanation": "Afraid always pairs with of."
            }
          ]
        }
      ],
      "key_takeaway": "Learn each adjective with its preposition.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
