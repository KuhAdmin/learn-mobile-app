      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Pairs to Remember",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "of: afraid of, proud of, full of, fond of",
            "at: good at, bad at",
            "in: interested in",
            "to: kind to, polite to",
            "from: different from",
            "for: famous for"
          ]
        }
      ],
      "key_takeaway": "Each adjective has its own preposition.",
      "page_audit": {
        "primary_objective_count": 1,
