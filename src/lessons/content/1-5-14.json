      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "An -ing Verb After the Pair",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "If a verb comes after the preposition, use its -ing form.",
          "scope": "Adjective + preposition + verb",
          "examples": [
            {
              "sentence": "Arjun is interested in collecting coins.",
              "highlight": [
                "interested in collecting"
              ],
              "explanation": "Collect becomes collecting after the preposition in."
            }
          ]
        }
      ],
      "key_takeaway": "Good at swimming, not good at swim.",
