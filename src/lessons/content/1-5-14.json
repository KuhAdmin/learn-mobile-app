      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Proud Of, Good At",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "Here are two very common pairs in sentences."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "Nani is proud of her rose garden.",
              "highlight": [
                "proud of"
              ],
              "explanation": "Proud pairs with of."
            },
            {
              "sentence": "Leela is good at chess.",
              "highlight": [
                "good at"
              ],
              "explanation": "Good pairs with at when we talk about a skill."
            }
          ]
        }
      ],
      "key_takeaway": "Proud of, good at.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Angry With or Angry About?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "With a person",
              "description": "Use with when the anger is at someone.",
              "example": "Mum was angry with my brother."
            },
            {
              "label": "About a thing",
              "description": "Use about when the anger is over something that happened.",
              "example": "Mum was angry about the broken vase."
            }
          ],
          "comparison_points": [
            "In the first sentence, the anger is at a person.",
            "In the second, it is over a thing that happened."
          ],
          "conclusion": "With a person; about a thing."
        }
      ],
      "key_takeaway": "Angry with someone, about something.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
