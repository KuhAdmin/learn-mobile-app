  "lesson": {
    "lesson_title": "Adjectives Followed by Prepositions",
    "lesson_summary": "Learners meet common adjective + preposition pairs that must be learned together: afraid of, proud of, full of, good at, interested in, kind to, angry with a person or about a thing, different from and famous for. They also learn that a verb after the preposition takes the -ing form ('good at swimming'). The full list of combinations is taught in Stage 4.1.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use common adjective + preposition pairs.",
        "success_criteria": [
          "Choose the right preposition after afraid, good, interested and others.",
          "Use angry with a person and angry about a thing."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use the -ing form after the preposition.",
        "success_criteria": [
          "Say 'interested in collecting', not 'interested in collect'."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
