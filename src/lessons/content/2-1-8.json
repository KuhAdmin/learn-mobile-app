      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "States Stay Simple",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Stative verbs behave differently from action verbs. They usually don't take -ing, even when we mean right now."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Rahul understands French perfectly.",
              "highlight": [
                "understands"
              ],
              "explanation": "Understanding is a state, so we don't say 'is understanding'."
            }
          ]
        }
      ],
      "key_takeaway": "States usually stay simple.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "No -ing for States",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Stative verbs (know, need, prefer, belong…) usually stay in their simple form, even when we mean right now.",
          "scope": "Verbs with a state meaning",
          "examples": [
            {
              "sentence": "I need a sharp pencil right now.",
              "highlight": [
                "need"
              ],
              "explanation": "Need is a state, so we say 'I need', not 'I am needing'."
            },
            {
              "sentence": "Meena prefers tea to coffee.",
              "highlight": [
                "prefers"
              ],
              "explanation": "Prefer is a feeling, so no -ing."
            }
          ]
        }
      ],
      "key_takeaway": "I know, not I am knowing.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Have: Owning or Doing?",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "comparison",
          "items": [
            {
              "label": "Owning (a state)",
              "description": "Means own or possess.",
              "example": "We have a big garden."
            },
            {
              "label": "Doing (an activity)",
              "description": "Means eat, drink or do something.",
              "example": "We are having lunch in the garden."
            }
          ],
          "comparison_points": [
            "In the first sentence, the meaning is own, so no -ing.",
            "In the second, having lunch is an activity, so -ing is fine."
          ],
          "conclusion": "Have takes -ing only when it means an activity."
        }
      ],
      "key_takeaway": "Having lunch, yes; having a garden, no.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Think: Opinion or Activity?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "Think can mean 'have an opinion' (a state) or 'use your mind' (an activity)."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "I think this plan will work.",
              "highlight": [
                "think"
              ],
              "explanation": "Here think means believe, an opinion, so no -ing."
            },
            {
              "sentence": "Grandpa is thinking about his old school.",
              "highlight": [
                "is thinking"
              ],
              "explanation": "Here thinking is an activity of the mind, so -ing is fine."
            }
          ]
        }
      ],
      "key_takeaway": "Opinion: think. Activity: is thinking.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Decide the Meaning First",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "Decide what the verb means here. A state stays simple; an activity can take -ing.",
          "scope": "Verbs such as have, think and see",
          "examples": [
            {
              "sentence": "The doctor is seeing patients until five.",
              "highlight": [
                "is seeing"
              ],
              "explanation": "Here see means meet, an activity, so -ing is fine."
            }
          ]
        }
      ],
      "key_takeaway": "The meaning decides whether -ing fits.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
