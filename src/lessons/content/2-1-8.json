  "lesson": {
    "lesson_title": "Dynamic and Stative Verb Usage",
    "lesson_summary": "Learners already know action (dynamic) and stative verbs (2-1-3). This lesson teaches how to use them: stative verbs usually stay in their simple form, even for right now ('I know', not 'I am knowing'), while verbs such as have, think and see have a state meaning and an action meaning, and only the action meaning can take -ing. Tense restrictions in full are taught in Stage 3.1.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use stative verbs without -ing.",
        "success_criteria": [
          "Say 'I believe you', not 'I am believing you'."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use verbs with a state and an action meaning.",
        "success_criteria": [
          "Tell 'We have a garden' from 'We are having lunch'.",
          "Explain two meanings of think and see."
        ]
      }
    ],
    "estimated_duration_minutes": 11,
    "total_pages": 6
  },
