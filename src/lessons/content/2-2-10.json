      "title": "Four Question Adverbs",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "When? – time: at noon, on Friday",
            "Where? – place: in the kitchen, upstairs",
            "Why? – reason: because it was raining",
            "How? – manner or way: by bus, slowly"
          ]
        }
      ],
      "key_takeaway": "Each one asks for a different answer.",
      "page_audit": {
        "primary_objective_count": 1,
