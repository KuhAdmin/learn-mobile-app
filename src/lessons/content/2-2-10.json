          "block_id": "BLOCK009",
          "type": "comparison",
          "items": [
            {
              "label": "When",
              "description": "Asks for a point in time.",
              "example": "When did the storm stop?"
            },
            {
              "label": "How long",
              "description": "Asks for a stretch of time.",
              "example": "How long did the storm last?"
            }
          ],
          "comparison_points": [
            "In the first question, the answer is a moment: at midnight.",
            "In the second, the answer is a length of time: for three hours."
          ],
          "conclusion": "Choose the question that matches the answer you want."
        }
      ],
      "key_takeaway": "When is a point; how long is a stretch.",
