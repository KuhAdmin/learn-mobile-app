  "lesson": {
    "lesson_title": "Interrogative Adverbs",
    "lesson_summary": "When, where, why and how are question adverbs: they ask about time, place, reason and manner. Learners match each one to its answer, build questions with how + another word (how often, how long, how far, how old, how soon), and tell when from how long. Who, what and which were taught in 1-3-8; word order in questions is left to Stage 2.4.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use when, where, why and how.",
        "success_criteria": [
          "Match each question adverb to what it asks.",
          "Give the right kind of answer."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Ask questions with how + another word.",
        "success_criteria": [
          "Use how often, how long, how far and how old."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Choose the question that fits an answer.",
        "success_criteria": [
          "Tell when from how long."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
