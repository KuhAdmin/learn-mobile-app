      "title": "Asking About Time, Place and Reason",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Who, what and which ask about people and things. When, where, why and how are question adverbs: they ask about time, place, reason and manner."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Where did you park the scooter?",
              "highlight": [
                "Where"
              ],
              "explanation": "Where asks about a place."
            }
          ]
        }
      ],
      "key_takeaway": "Question adverbs ask when, where, why, how.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 47,
        "density_status": "passed",
