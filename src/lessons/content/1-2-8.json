  "lesson": {
    "lesson_title": "Singular and Plural Nouns",
    "lesson_summary": "Learners meet the idea of number: a singular noun names one and a plural noun names more than one. They spot plural nouns from clues such as an -s ending or a number, learn that not every word ending in -s is plural, and meet nouns that are always plural (scissors) or end in -s but are singular (news). Plural spelling rules are left to 1-2-9 and verb agreement to Stage 2.3.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Explain the difference between singular and plural nouns.",
        "success_criteria": [
          "Say whether a noun names one or more than one."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Spot plural nouns in a sentence.",
        "success_criteria": [
          "Use an -s ending and numbers as clues.",
          "Tell a singular noun that ends in s from a plural noun."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Recognise nouns that are always plural.",
        "success_criteria": [
          "Name two-part items such as scissors and trousers.",
          "Count them with 'a pair of'."
        ]
      },
      {
        "objective_id": "OBJ004",
        "description": "Recognise singular nouns that end in -s.",
        "success_criteria": [
          "Explain that news and maths are singular."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 9
  },
