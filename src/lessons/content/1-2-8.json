      "title": "Singular and Plural: Recap",
      "content": [
        {
          "block_id": "BLOCK017",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Singular means one: a parrot.",
            "Plural means more than one: three parrots.",
            "Most plurals end in -s, but not every -s word is plural.",
            "Some nouns are always plural: scissors, jeans.",
            "Some -s nouns are singular: news, maths."
          ]
        }
      ],
      "key_takeaway": "Ask: is it one, or more than one?",
