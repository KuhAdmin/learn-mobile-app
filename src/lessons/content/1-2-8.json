  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "One or Many?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "One star in the sky, or a sky full of them? English shows the difference in the noun itself: star, stars."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "First one star appeared, then hundreds of stars.",
              "highlight": [
                "star",
                "stars"
              ],
              "explanation": "Star names one. Stars names more than one."
            }
          ]
        }
      ],
      "key_takeaway": "A noun can show one or more than one.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Singular Nouns",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "text",
          "text": "A singular noun names just one person, animal, place or thing."
        },
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "A parrot sat on the gate.",
              "highlight": [
                "parrot"
              ],
              "explanation": "Parrot names one bird, so it is singular."
            },
            {
              "sentence": "I have one younger sister.",
              "highlight": [
                "sister"
              ],
              "explanation": "Sister names one person, so it is singular."
            }
          ]
        }
      ],
      "key_takeaway": "Singular means one.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Plural Nouns",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "text",
          "text": "A plural noun names more than one. Most plural nouns end in -s."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Three parrots sat on the gate.",
              "highlight": [
                "parrots"
              ],
              "explanation": "Parrots names more than one bird, so it is plural."
            },
            {
              "sentence": "I have two younger sisters.",
              "highlight": [
                "sisters"
              ],
              "explanation": "Sisters names more than one person, so it is plural."
            }
          ]
        }
      ],
      "key_takeaway": "Plural means more than one.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Clues for Plural Nouns",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "Look for -s at the end of a noun. A number such as two or ten before the noun is another clue."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "Ten candles glowed on the cake.",
              "highlight": [
                "candles"
              ],
              "explanation": "The number ten and the -s ending both show that candles is plural."
            },
            {
              "sentence": "The farmer planted rows of beans.",
              "highlight": [
                "rows",
                "beans"
              ],
              "explanation": "Rows and beans end in -s and name more than one."
            }
          ]
        }
      ],
      "key_takeaway": "An -s ending and a number are plural clues.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Not Every -s Means Plural",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "text",
          "text": "Some singular nouns already end in s, like bus, dress and class. Some verbs end in s too. Check the meaning: is it one, or more than one?"
        },
        {
          "block_id": "BLOCK010",
          "type": "example",
          "examples": [
            {
              "sentence": "The bus left at nine.",
              "highlight": [
                "bus"
              ],
              "explanation": "Bus ends in s, but it names one bus, so it is singular."
            },
            {
              "sentence": "She paints every Sunday.",
              "highlight": [
                "paints"
              ],
              "explanation": "Paints is an action here, not a plural noun."
            }
          ]
        }
      ],
      "key_takeaway": "Check the meaning, not just the -s.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 55,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "exception",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Nouns That Are Always Plural",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "text",
          "text": "Some things have two matching parts, like scissors, trousers, jeans and glasses for your eyes. Their nouns are always plural, even for one item."
        },
        {
          "block_id": "BLOCK012",
          "type": "example",
          "examples": [
            {
              "sentence": "Grandpa lost his reading glasses.",
              "highlight": [
                "glasses"
              ],
              "explanation": "One item with two lenses, so the noun is plural."
            },
            {
              "sentence": "Mum sharpened the scissors yesterday.",
              "highlight": [
                "scissors"
              ],
              "explanation": "Scissors have two blades, so the noun is always plural."
            }
          ]
        }
      ],
      "key_takeaway": "Two-part items take plural nouns.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 52,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Counting With A Pair Of",
      "content": [
        {
          "block_id": "BLOCK013",
          "type": "text",
          "text": "To count two-part items, use 'a pair of': a pair of jeans, two pairs of trousers."
        },
        {
          "block_id": "BLOCK014",
          "type": "example",
          "examples": [
            {
              "sentence": "I bought a pair of jeans for the trip.",
              "highlight": [
                "pair"
              ],
              "explanation": "A pair of jeans means one item."
            },
            {
              "sentence": "She packed three pairs of shorts.",
              "highlight": [
                "pairs"
              ],
              "explanation": "Three pairs of shorts means three items."
            }
          ]
        }
      ],
      "key_takeaway": "Count two-part items in pairs.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE008",
      "page_number": 8,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ004"
      ],
      "title": "Singular Nouns Ending in -s",
      "content": [
        {
          "block_id": "BLOCK015",
          "type": "text",
          "text": "A few nouns end in -s but are singular. News, maths and physics look plural, but each names one thing."
        },
        {
          "block_id": "BLOCK016",
          "type": "example",
          "examples": [
            {
              "sentence": "The news shocked the whole town.",
              "highlight": [
                "news"
              ],
              "explanation": "News names information. There is no singular form 'new' for it, so news is singular."
            },
            {
              "sentence": "Maths helped her win the science prize.",
              "highlight": [
                "Maths"
              ],
              "explanation": "Maths names one school subject, so it is singular."
            }
          ]
        }
      ],
      "key_takeaway": "News and maths end in -s but are singular.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 52,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
