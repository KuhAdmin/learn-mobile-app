  "lesson": {
    "lesson_title": "Interrogative Determiners",
    "lesson_summary": "Learners already know who, what, which and whose standing alone in questions (1-3-8). This lesson puts what, which and whose before a noun. The what/which rule is the same as for the pronouns, so it is recalled in one page; whose + noun asks about the owner. It also adds 'what kind of' and 'what sort of' + noun, and everyday questions with what colour, what size and what time.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose what or which before a noun.",
        "success_criteria": [
          "Use what for an open choice.",
          "Use which for a choice from a set."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use whose before a noun.",
        "success_criteria": [
          "Ask about the owner with whose + noun."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Ask with what kind of, what colour, what size and what time.",
        "success_criteria": [
          "Ask 'What kind of music do you like?'",
          "Choose what colour, size or time for the answer wanted."
        ]
      }
    ],
    "estimated_duration_minutes": 10,
    "total_pages": 5
  },
