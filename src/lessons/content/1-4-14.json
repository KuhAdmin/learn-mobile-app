  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Question Words With a Noun",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "What, which and whose can sit right before a noun in a question. Then they are determiners."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Which bus goes to the old fort?",
              "highlight": [
                "Which bus"
              ],
              "explanation": "Which comes before the noun bus and asks us to pick one bus."
            }
          ]
        }
      ],
      "key_takeaway": "Question words can come before a noun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "concept",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "What or Which Before a Noun",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "text",
          "text": "The rule you met with the question pronouns (1-3-8) works the same before a noun: what + noun for any answer, which + noun to pick from a few."
        },
        {
          "block_id": "BLOCK006",
          "type": "example",
          "examples": [
            {
              "sentence": "Which kurta do you prefer, the yellow or the green?",
              "highlight": [
                "Which kurta"
              ],
              "explanation": "There are only two kurtas to choose from, so which."
            }
          ]
        }
      ],
      "key_takeaway": "Same rule as the pronouns: what is open, which picks.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Whose + Noun: The Owner",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "Use whose + noun to ask who something belongs to."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "Whose phone keeps ringing in the hall?",
              "highlight": [
                "Whose phone"
              ],
              "explanation": "We want to know the owner of the phone."
            }
          ]
        }
      ],
      "key_takeaway": "Whose + noun asks about the owner.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 26,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "What Kind Of, What Colour",
      "content": [
        {
          "block_id": "BLOCK011",
          "type": "text",
          "text": "What kind of (or what sort of) + noun asks about type. What colour, what size and what time ask about one detail."
        },
        {
          "block_id": "BLOCK012",
          "type": "example",
          "examples": [
            {
              "sentence": "What sort of shoes do you need for the trek?",
              "highlight": [
                "What sort of"
              ],
              "explanation": "The answer is a type of shoe, such as hiking boots."
            },
            {
              "sentence": "What colour is the new school bus?",
              "highlight": [
                "What colour"
              ],
              "explanation": "The answer will be a colour, such as yellow."
            }
          ]
        }
      ],
      "key_takeaway": "What kind of asks about type.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Question Determiners: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "What + noun: an open choice.",
            "Which + noun: a choice from a few.",
            "Whose + noun: the owner.",
            "Without a noun after them, they are pronouns.",
            "What kind of asks about type; what colour, size and time ask about one detail."
          ]
        }
      ],
      "key_takeaway": "Put the right question word before the noun.",
