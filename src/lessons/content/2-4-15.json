      ],
      "title": "Statements Keep the Subject First",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "A statement gives information. Its order is subject, verb, then object or complement, then the adverbials (2-2-14)."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "My cousin bought a scooter last month.",
              "highlight": [
                "My cousin bought a scooter"
              ],
              "explanation": "Subject, verb, object, then when."
            }
          ]
        }
      ],
      "key_takeaway": "Statement order: subject, verb, the rest.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
