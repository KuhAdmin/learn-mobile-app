      "page_type": "example",
      "pedagogical_role": "demonstration",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Putting the Parts Together",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "example",
          "examples": [
            {
              "sentence": "Our class visited the planetarium by bus on Friday.",
              "highlight": [
                "Our class visited the planetarium"
              ],
              "explanation": "The core comes first; the adverbials follow."
            }
          ]
        }
      ],
      "key_takeaway": "Line the parts up in order.",
