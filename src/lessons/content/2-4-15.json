  "lesson": {
    "lesson_title": "Word Order in Statements",
    "lesson_summary": "A statement keeps the order subject, verb, object or complement, then adverbials (2-2-14). Learners put statements in order, never drop the subject (We went…, not Went…; It is raining, not Is raining), and keep statement order when a question sits inside a statement (I know where she lives.). Reported questions in full are left to Stage 3.5.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Put a statement in the right order.",
        "success_criteria": [
          "Order subject, verb, object and adverbials."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Never drop the subject.",
        "success_criteria": [
          "Add a missing I or we.",
          "Use it for weather, time and distance."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Keep statement order for questions inside statements.",
        "success_criteria": [
          "Say I know where she lives."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
