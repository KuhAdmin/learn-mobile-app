      "content": [
        {
          "block_id": "BLOCK005",
          "type": "warning",
          "title": "Common mistake",
          "mistake": {
            "incorrect": "Went to the beach on Sunday.",
            "correct": "We went to the beach on Sunday.",
            "reason": "A statement needs a subject. Only commands leave it out (2-4-2)."
          },
          "related_learning_objective_ids": [
            "OBJ002"
          ]
        },
        {
          "block_id": "BLOCK006",
          "type": "note",
          "title": "Remember",
          "text": "One subject is enough, too: My sister plays the sitar, not My sister she plays (1-3-15)."
        }
      ],
      "key_takeaway": "Only commands leave out the subject.",
