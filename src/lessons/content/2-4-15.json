      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "The Statement Order",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "Build a statement in this order:",
          "list_style": "bulleted",
          "items": [
            "Subject: Our class",
            "Verb: visited",
            "Object or complement: the planetarium",
            "Adverbials (how, where, when): by bus on Friday"
          ]
        }
      ],
      "key_takeaway": "Who, does what, to what, then how, where, when.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 27,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
