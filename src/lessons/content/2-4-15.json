    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Don't Drop the Subject",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "rule",
          "rule_id": "RULE007",
          "rule_text": "An English statement always needs a subject. For weather, time and distance, use it.",
          "scope": "Empty it",
          "examples": [
            {
              "sentence": "It is raining in Mumbai.",
              "highlight": [
                "It is raining"
              ],
              "explanation": "It is the subject, even though it doesn't name anything."
            },
            {
              "sentence": "It is a long way to the station.",
              "highlight": [
                "It is a long way"
              ],
              "explanation": "It is the subject of a sentence about distance."
            }
          ]
        },
        {
          "block_id": "BLOCK008",
          "type": "note",
          "title": "Not this",
          "text": "Is raining in Mumbai."
        }
      ],
      "key_takeaway": "For weather, time and distance, use it.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 71,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "A Question Inside a Statement",
      "content": [
        {
          "block_id": "BLOCK009",
          "type": "rule",
          "rule_id": "RULE009",
          "rule_text": "When a question sits inside a statement, use statement order: subject before verb, and no do.",
          "scope": "Questions inside statements",
          "examples": [
            {
              "sentence": "I know where Priya lives.",
              "highlight": [
                "where Priya lives"
              ],
              "explanation": "Priya comes before lives, and there is no does."
            }
          ]
        },
        {
          "block_id": "BLOCK010",
          "type": "note",
          "title": "Not this",
          "text": "I know where does Priya live."
        }
      ],
      "key_takeaway": "Inside a statement, no question order.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 54,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
