  "lesson": {
    "lesson_title": "Quantifiers",
    "lesson_summary": "Learners use quantifiers before a noun to say how much or how many. They choose many for countable nouns and much for uncountable ones, some and any by the same rule as someone and anyone, tell a few from few and a little from little, and use a lot of, enough and no. All, both and half come in 1-4-15, and each and every in 1-4-12.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose many or much, and some or any.",
        "success_criteria": [
          "Use many with countable and much with uncountable nouns.",
          "Use some in positives and offers, any in questions and negatives."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Tell a few from few and a little from little.",
        "success_criteria": [
          "Explain that few means not enough."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use a lot of, enough and no.",
        "success_criteria": [
          "Use a lot of with both kinds of noun.",
          "Use no to mean none at all."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 6
  },
