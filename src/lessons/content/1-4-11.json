  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "How Much? How Many?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Quantifiers come before a noun and tell us how much or how many, without giving an exact number."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "We have plenty of time but not many tickets.",
              "highlight": [
                "plenty of",
                "many"
              ],
              "explanation": "Plenty of tells how much time; many tells how many tickets."
            }
          ]
        }
      ],
      "key_takeaway": "Quantifiers tell roughly how much or how many.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Many, Much, Some and Any",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use many with countable nouns and much with uncountable nouns. Much is most common in questions and with not.",
          "scope": "Many and much before a noun",
          "examples": [
            {
              "sentence": "How many cousins do you have?",
              "highlight": [
                "many"
              ],
              "explanation": "Cousins can be counted, so many."
            },
            {
              "sentence": "We don't have much petrol left.",
              "highlight": [
                "much"
              ],
              "explanation": "Petrol is uncountable, so much."
            }
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Some and any",
          "text": "Same rule as someone and anyone (1-3-10): some in positives and offers, any in questions and with not."
        }
      ],
      "key_takeaway": "Many for countable, much for uncountable.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A Few or Few?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "comparison",
          "items": [
            {
              "label": "A few",
              "description": "Some: a small but useful number.",
              "example": "A few neighbours came to help, so we finished quickly."
            },
            {
              "label": "Few",
              "description": "Not many: not enough.",
              "example": "Few neighbours came to help, so we finished late."
            }
          ],
          "comparison_points": [
            "In the first sentence, the helpers were enough.",
            "In the second, there were too few helpers."
          ],
          "conclusion": "A few sounds hopeful; few sounds disappointed."
        }
      ],
      "key_takeaway": "A few is some; few is not enough.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 48,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "A Little or Little?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "The same idea works with uncountable nouns: a little means some; little means not much."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "There's a little rice left if you're still hungry.",
              "highlight": [
                "a little"
              ],
              "explanation": "A little means some rice, enough for a small helping."
            },
            {
              "sentence": "There is little hope of rain this week.",
              "highlight": [
                "little"
              ],
              "explanation": "Little means hardly any hope."
            }
          ]
        }
      ],
      "key_takeaway": "A little is some; little is hardly any.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "A Lot Of, Enough and No",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "A lot of and lots of work with both kinds of noun. Enough means as much as we need. No means none at all."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "We have a lot of homework tonight.",
              "highlight": [
                "a lot of"
              ],
              "explanation": "A lot of means a large amount; it works with uncountable homework."
            },
            {
              "sentence": "Is there enough paint for the whole wall?",
              "highlight": [
                "enough"
              ],
              "explanation": "Enough asks whether the amount is as much as needed."
            }
          ]
        }
      ],
      "key_takeaway": "A lot of fits both kinds of noun.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Quantifiers: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "Many + countable; much + uncountable.",
            "Some in positives and offers; any in questions and with not.",
            "A few and a little: some. Few and little: not enough.",
            "A lot of works with both kinds.",
            "Enough: as much as needed. No: none at all."
          ]
        }
      ],
      "key_takeaway": "Pick the quantifier that fits the noun.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    }
