  "lesson": {
    "lesson_title": "Participial Adjectives",
    "lesson_summary": "Learners use adjectives that end in -ing and -ed. An -ing adjective describes what causes a feeling (boring, exciting); an -ed adjective describes the feeling someone has (bored, excited). They practise common pairs and meet other past-form adjectives such as broken, frozen and fallen. Participles as verb forms are taught in Stage 5.1.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Choose -ing or -ed adjectives.",
        "success_criteria": [
          "Use -ing for the cause of a feeling.",
          "Use -ed for the person who feels it."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Recognise other past-form adjectives.",
        "success_criteria": [
          "Spot broken, frozen and fallen as adjectives."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 7
  },
