      "title": "Boring or Bored?",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "-ing adjective",
              "description": "Describes the cause.",
              "example": "The long speech was boring."
            },
            {
              "label": "-ed adjective",
              "description": "Describes the feeling.",
              "example": "The audience felt bored."
            }
          ],
          "comparison_points": [
            "In the first sentence, the speech caused the feeling.",
            "In the second, the people had the feeling."
          ],
          "conclusion": "Things are boring; people feel bored."
        }
      ],
      "key_takeaway": "A film is boring; you feel bored.",
