      "title": "Broken, Frozen, Fallen",
      "content": [
        {
          "block_id": "BLOCK007",
          "type": "text",
          "text": "Other past forms of verbs also work as adjectives: broken, frozen, fallen, torn, stolen."
        },
        {
          "block_id": "BLOCK008",
          "type": "example",
          "examples": [
            {
              "sentence": "A fallen tree blocked the hill road.",
              "highlight": [
                "fallen"
              ],
              "explanation": "Fallen describes the tree: it has fallen down."
            },
            {
              "sentence": "Mum keeps frozen peas for quick meals.",
              "highlight": [
                "frozen"
              ],
              "explanation": "Frozen describes the peas: they have been frozen."
            }
          ]
        }
      ],
      "key_takeaway": "Past forms such as broken can describe nouns.",
