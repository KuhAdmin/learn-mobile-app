  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Adjectives That End in -ing and -ed",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Many adjectives end in -ing or -ed. They come from verbs, but here they describe nouns."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The thrilling final left the whole stadium thrilled.",
              "highlight": [
                "thrilling",
                "thrilled"
              ],
              "explanation": "Thrilling describes the final; thrilled describes how the crowd felt."
            }
          ]
        }
      ],
      "key_takeaway": "Some adjectives end in -ing or -ed.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 32,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "-ing: What Causes the Feeling",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "An -ing adjective describes the thing or person that causes a feeling.",
          "scope": "Pairs such as amusing/amused",
          "examples": [
            {
              "sentence": "The puppet show was amusing.",
              "highlight": [
                "amusing"
              ],
              "explanation": "The show caused the feeling, so -ing."
            }
          ]
        }
      ],
      "key_takeaway": "-ing describes the cause.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "-ed: How Someone Feels",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE002",
          "rule_text": "An -ed adjective describes the person or animal that has the feeling.",
          "scope": "Pairs such as amusing/amused",
          "examples": [
            {
              "sentence": "The children were amused by the puppets.",
              "highlight": [
                "amused"
              ],
              "explanation": "The children had the feeling, so -ed."
            }
          ]
        }
      ],
      "key_takeaway": "-ed describes the feeling.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 28,
