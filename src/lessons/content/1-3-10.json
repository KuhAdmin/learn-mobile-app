      "page_id": "PAGE007",
      "page_number": 7,
      "page_type": "summary",
      "pedagogical_role": "reinforcement",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Indefinite Pronouns: Recap",
      "content": [
        {
          "block_id": "BLOCK012",
          "type": "list",
          "introduction": "Remember:",
          "list_style": "bulleted",
          "items": [
            "-one and -body for people; -thing for things.",
            "Some- for positives and offers; any- for questions and not.",
            "Nobody and nothing need no extra not.",
            "Every- words mean all.",
            "All, many, few, both, none tell roughly how many."
          ]
        }
      ],
      "key_takeaway": "Talk about people and things in general.",
