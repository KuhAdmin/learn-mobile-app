  "lesson": {
    "lesson_title": "Indefinite Pronouns",
    "lesson_summary": "Learners use pronouns that don't name exactly who or what: someone, anybody, nobody, everything and the rest, plus amount words such as many, few, several, both and none. They pick -one or -body for people and -thing for things, and choose some-, any-, no- or every- by the kind of sentence. Verb agreement after these pronouns is left to Stage 2.3, and each, either and neither to 1-3-11.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Use -one, -body and -thing pronouns.",
        "success_criteria": [
          "Use -one or -body for people and -thing for things."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Choose some-, any-, no- or every-.",
        "success_criteria": [
          "Use some- in positive sentences and offers.",
          "Use any- in questions and negatives.",
          "Keep the verb positive after nobody and nothing."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Recognise pronouns of amount.",
        "success_criteria": [
          "Understand all, many, few, several, both and none."
        ]
      }
    ],
    "estimated_duration_minutes": 13,
    "total_pages": 7
  },
