  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Not Naming Anyone Exactly",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Sometimes we don't know, or don't need to say, exactly who or what. Indefinite pronouns let us talk about people and things in general."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Somebody left a bunch of marigolds on our doorstep.",
              "highlight": [
                "Somebody"
              ],
              "explanation": "We don't know who left them, so we say somebody."
            }
          ]
        }
      ],
      "key_takeaway": "Indefinite pronouns don't name exactly who.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 42,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "People Words and Thing Words",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "list",
          "introduction": "The ending tells you whether it means a person or a thing:",
          "list_style": "bulleted",
          "items": [
            "People (-one, -body): someone, anybody, everyone, nobody",
            "Things (-thing): something, anything, everything, nothing"
          ]
        },
        {
          "block_id": "BLOCK004",
          "type": "note",
          "title": "Same meaning",
          "text": "Someone and somebody mean the same, and so do everyone and everybody."
        }
      ],
      "key_takeaway": "-one and -body mean people; -thing means things.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 40,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Some- or Any-?",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "Use some- words in positive sentences and in offers. Use any- words in most questions and with not.",
          "scope": "Someone, something, anybody, anything and similar words",
          "examples": [
            {
              "sentence": "Would you like something cold to drink?",
              "highlight": [
                "something"
              ],
              "explanation": "This is an offer, so some- fits even in a question."
            },
            {
              "sentence": "I can't find anything in this messy drawer.",
              "highlight": [
                "anything"
              ],
              "explanation": "Can't makes the sentence negative, so any- fits."
            }
          ]
        }
      ],
      "key_takeaway": "Offers and positives: some-. Questions and not: any-.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "exception",
      "pedagogical_role": "recognition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "No- Words Already Mean Not",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "text",
          "text": "Nobody, no one and nothing already carry the meaning 'not', so the verb stays positive."
        },
        {
          "block_id": "BLOCK007",
          "type": "example",
          "examples": [
            {
              "sentence": "Nothing was left on the plate after dinner.",
              "highlight": [
                "Nothing"
              ],
              "explanation": "Nothing already means 'not anything', so we don't add another not."
            }
          ]
        }
      ],
      "key_takeaway": "With nobody or nothing, keep the verb positive.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 35,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Every- Means All",
      "content": [
        {
          "block_id": "BLOCK008",
          "type": "text",
          "text": "Everyone, everybody and everything mean all the people or all the things."
        },
        {
          "block_id": "BLOCK009",
          "type": "example",
          "examples": [
            {
              "sentence": "Everyone clapped when the curtain rose.",
              "highlight": [
                "Everyone"
              ],
              "explanation": "Everyone means all the people in the audience."
            }
          ]
        }
      ],
      "key_takeaway": "Every- words include all of them.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE006",
      "page_number": 6,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ003"
      ],
      "title": "Pronouns That Count Roughly",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "text",
          "text": "Some indefinite pronouns tell us roughly how many: all, many, few, several, both and none."
        },
        {
          "block_id": "BLOCK011",
          "type": "example",
          "examples": [
            {
              "sentence": "Many came to the mela, but few stayed for the fireworks.",
              "highlight": [
                "Many",
                "few"
              ],
              "explanation": "Many means a large number of people; few means only a small number."
            }
          ]
        }
      ],
      "key_takeaway": "Many, few, both and none tell roughly how many.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
