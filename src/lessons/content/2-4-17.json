  "lesson": {
    "lesson_title": "Word Order in Negative Sentences",
    "lesson_summary": "To make a sentence negative, put not after the first helper or after be; with no helper, use don't, doesn't or didn't + the base form. Learners use the short forms (isn't, can't, won't) and keep to one negative: no double negatives, and no extra not after nobody, nothing or never. Some and any were taught in 1-4-11; neither … nor in 2-3-9.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Put not in the right place.",
        "success_criteria": [
          "Put not after the first helper or be."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Use don't, doesn't and didn't.",
        "success_criteria": [
          "Use the base form after them.",
          "Use short forms."
        ]
      },
      {
        "objective_id": "OBJ003",
        "description": "Use only one negative.",
        "success_criteria": [
          "Fix a double negative.",
          "Use nobody, nothing and never without not."
        ]
      }
    ],
    "estimated_duration_minutes": 12,
    "total_pages": 8
  },
