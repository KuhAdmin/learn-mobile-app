      "title": "Negative Order: Recap",
      "content": [
        {
          "block_id": "BLOCK010",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "Not goes after the first helper or be.",
            "No helper: don't, doesn't, didn't + base form.",
            "Short forms: isn't, can't, won't.",
            "One negative only.",
            "Nobody, nothing, never: no extra not."
          ]
        }
      ],
      "key_takeaway": "Put not in its place, and use it once.",
