  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001",
        "OBJ002",
        "OBJ003"
      ],
      "title": "Saying No",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "To make a sentence negative, add not in the right place."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "The baby is not asleep yet.",
              "highlight": [
                "is not"
              ],
              "explanation": "Not comes straight after is."
            }
          ]
        }
      ],
      "key_takeaway": "Not goes in one fixed place.",
      "page_audit": {
        "primary_objective_count": 3,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Not After the First Helper",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE003",
          "rule_text": "Put not after the first helping verb.",
          "scope": "Sentences with a helper",
          "examples": [
            {
              "sentence": "We have not finished our project.",
              "highlight": [
                "have not finished"
              ],
              "explanation": "Not sits between have and finished."
            },
            {
              "sentence": "Tara will not forget your birthday.",
              "highlight": [
                "will not forget"
              ],
              "explanation": "Not sits between will and forget."
            }
          ]
        }
      ],
      "key_takeaway": "Helper, then not, then the main verb.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 49,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Not After Be",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "rule",
          "rule_id": "RULE004",
          "rule_text": "When the verb is be, put not straight after it.",
          "scope": "The verb be",
          "examples": [
            {
              "sentence": "The shops were not crowded today.",
              "highlight": [
                "were not crowded"
              ],
              "explanation": "Not comes right after were."
            }
          ]
        }
      ],
      "key_takeaway": "Am, is, are, was, were + not.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 33,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "No Helper? Use Don't, Doesn't or Didn't",
      "content": [
        {
          "block_id": "BLOCK005",
          "type": "rule",
          "rule_id": "RULE005",
          "rule_text": "If there is no helper, add do not, does not or did not. The main verb goes back to its base form.",
          "scope": "Sentences with no helper",
          "examples": [
            {
              "sentence": "My brother doesn't like okra.",
              "highlight": [
                "doesn't like"
              ],
              "explanation": "Doesn't carries the -s, so like has none."
            },
            {
              "sentence": "We didn't hear the doorbell.",
              "highlight": [
                "didn't hear"
              ],
              "explanation": "Didn't shows the past, so hear stays in its base form."
            }
          ]
        }
      ],
      "key_takeaway": "Do-word + not + base form.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 69,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE005",
      "page_number": 5,
      "page_type": "classification",
      "pedagogical_role": "decomposition",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Short Forms",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "list",
          "list_style": "bulleted",
          "items": [
            "is not → isn't",
            "are not → aren't",
            "do not → don't",
            "does not → doesn't",
            "did not → didn't",
            "cannot → can't",
            "will not → won't"
          ]
        },
        {
          "block_id": "BLOCK007",
          "type": "note",
          "title": "When to use them",
          "text": "Short forms are normal in speech and friendly writing."
        }
      ],
      "key_takeaway": "Short forms are normal in speech.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 34,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
