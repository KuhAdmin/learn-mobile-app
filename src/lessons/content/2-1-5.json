  "lesson": {
    "lesson_title": "Transitive and Intransitive Verbs",
    "lesson_summary": "Learners tell transitive verbs, whose action passes to an object (ask what? or whom?), from intransitive verbs, which are complete without one and may be followed by a place or time phrase. They meet verbs that can be used both ways. Direct and indirect objects are taught in Stage 2.4, and the passive voice in Stage 3.4.",
    "learning_objectives": [
      {
        "objective_id": "OBJ001",
        "description": "Tell transitive from intransitive verbs.",
        "success_criteria": [
          "Find the object with what? or whom?",
          "Recognise verbs that need no object."
        ]
      },
      {
        "objective_id": "OBJ002",
        "description": "Recognise verbs that can be both.",
        "success_criteria": [
          "Explain 'reading a comic' and 'reading in his room'."
        ]
      }
    ],
    "estimated_duration_minutes": 10,
    "total_pages": 5
  },
