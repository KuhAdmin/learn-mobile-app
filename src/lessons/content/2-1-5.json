  "pages": [
    {
      "page_id": "PAGE001",
      "page_number": 1,
      "page_type": "introduction",
      "pedagogical_role": "introduction",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Does the Action Pass On?",
      "content": [
        {
          "block_id": "BLOCK001",
          "type": "text",
          "text": "Some verbs need an object to finish their meaning. Others are complete on their own."
        },
        {
          "block_id": "BLOCK002",
          "type": "example",
          "examples": [
            {
              "sentence": "Kavya bought a kite, and her brother laughed.",
              "highlight": [
                "bought",
                "laughed"
              ],
              "explanation": "Bought needs an object (a kite); laughed is complete without one."
            }
          ]
        }
      ],
      "key_takeaway": "Some verbs need an object; some don't.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 30,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE002",
      "page_number": 2,
      "page_type": "rule",
      "pedagogical_role": "rule_application",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Transitive: The Action Passes On",
      "content": [
        {
          "block_id": "BLOCK003",
          "type": "rule",
          "rule_id": "RULE001",
          "rule_text": "A transitive verb needs an object. Ask the verb what? or whom? The answer is the object.",
          "scope": "Verbs with objects",
          "examples": [
            {
              "sentence": "The cat caught a moth.",
              "highlight": [
                "caught"
              ],
              "explanation": "Caught what? A moth, so caught is transitive."
            },
            {
              "sentence": "Our coach praised the whole team.",
              "highlight": [
                "praised"
              ],
              "explanation": "Praised whom? The whole team, so praised is transitive."
            }
          ]
        }
      ],
      "key_takeaway": "Ask what? or whom? to find the object.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE003",
      "page_number": 3,
      "page_type": "concept",
      "pedagogical_role": "explanation",
      "learning_objective_ids": [
        "OBJ001"
      ],
      "title": "Intransitive: Complete on Its Own",
      "content": [
        {
          "block_id": "BLOCK004",
          "type": "text",
          "text": "An intransitive verb has no object. A place or time phrase may follow it, but that phrase is not an object."
        },
        {
          "block_id": "BLOCK005",
          "type": "example",
          "examples": [
            {
              "sentence": "The train arrived at platform two.",
              "highlight": [
                "arrived"
              ],
              "explanation": "Arrived needs no object; 'at platform two' only tells where."
            },
            {
              "sentence": "Everyone in the hall clapped.",
              "highlight": [
                "clapped"
              ],
              "explanation": "Clapped is complete without an object."
            }
          ]
        }
      ],
      "key_takeaway": "Intransitive verbs stand without an object.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 38,
        "density_status": "passed",
        "standalone_understanding": "passed"
      }
    },
    {
      "page_id": "PAGE004",
      "page_number": 4,
      "page_type": "comparison",
      "pedagogical_role": "comparison",
      "learning_objective_ids": [
        "OBJ002"
      ],
      "title": "Verbs That Can Be Both",
      "content": [
        {
          "block_id": "BLOCK006",
          "type": "comparison",
          "items": [
            {
              "label": "With an object",
              "description": "Transitive use.",
              "example": "Ravi is reading a comic."
            },
            {
              "label": "Without an object",
              "description": "Intransitive use.",
              "example": "Ravi is reading in his room."
            }
          ],
          "comparison_points": [
            "In the first sentence, a comic answers 'reading what?'",
            "In the second, nothing answers what?; 'in his room' only tells where."
          ],
          "conclusion": "Some verbs, like read, eat and win, can be used either way."
        }
      ],
      "key_takeaway": "Read, eat and win can take an object or not.",
      "page_audit": {
        "primary_objective_count": 1,
        "estimated_visible_word_count": 45,
